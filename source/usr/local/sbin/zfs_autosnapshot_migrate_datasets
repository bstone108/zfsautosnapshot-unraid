#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'

ZFSAS_LOG_HELPER="/usr/local/emhttp/plugins/zfs.autosnapshot/scripts/log-maintenance-lib.sh"
if [[ -r "$ZFSAS_LOG_HELPER" ]]; then
  # shellcheck source=/dev/null
  source "$ZFSAS_LOG_HELPER"
else
  zfsas_log_sanitize_text() { printf '%s' "$1"; }
  zfsas_log_prepare_for_append() { return 0; }
fi

PLUGIN_ROOT="${ZFSAS_MIGRATOR_PLUGIN_ROOT:-/boot/config/plugins/zfs.autosnapshot/dataset_migrator}"
LOGS_DIR="${ZFSAS_MIGRATOR_LOGS_DIR:-${PLUGIN_ROOT}/logs}"
STATUS_FILE="${ZFSAS_MIGRATOR_STATUS_FILE:-${PLUGIN_ROOT}/status.env}"
FOLDERS_FILE="${ZFSAS_MIGRATOR_FOLDERS_FILE:-${PLUGIN_ROOT}/folders.tsv}"
CONTAINERS_FILE="${ZFSAS_MIGRATOR_CONTAINERS_FILE:-${PLUGIN_ROOT}/containers.tsv}"
RECOVERY_STATE_FILE="${ZFSAS_MIGRATOR_RECOVERY_STATE_FILE:-${PLUGIN_ROOT}/recovery.env}"
RECOVERY_ALERT_STAMP="${ZFSAS_MIGRATOR_RECOVERY_ALERT_STAMP:-${PLUGIN_ROOT}/recovery.alert}"
IN_PROGRESS_FLAG="${ZFSAS_MIGRATOR_IN_PROGRESS_FLAG:-${PLUGIN_ROOT}/migration.inprogress}"
LOG_FILE="${ZFSAS_MIGRATOR_LOG_FILE:-/var/log/zfs_autosnapshot_migrate_datasets.log}"
LOG_ARCHIVE_FILE="${ZFSAS_MIGRATOR_LOG_ARCHIVE_FILE:-/var/log/zfs_autosnapshot_migrate_datasets.archive.log}"
LOCK_FILE="${ZFSAS_MIGRATOR_LOCK_FILE:-/var/run/zfs-autosnapshot-migrator/migrator.lock}"
SPACE_RECHECK_SECONDS="${ZFSAS_MIGRATOR_SPACE_RECHECK_SECONDS:-300}"
RESTART_RETRY_DELAY="${ZFSAS_MIGRATOR_RESTART_RETRY_DELAY:-300}"
RECOVERY_BOOT_DELAY_SECONDS="${ZFSAS_MIGRATOR_RECOVERY_BOOT_DELAY_SECONDS:-900}"
REVERTED_FOLDERS_FILE="${ZFSAS_MIGRATOR_REVERTED_FOLDERS_FILE:-${PLUGIN_ROOT}/reverted-folders.tsv}"
RC_DOCKER="${ZFSAS_MIGRATOR_RC_DOCKER:-/etc/rc.d/rc.docker}"
RC_LIBVIRT="${ZFSAS_MIGRATOR_RC_LIBVIRT:-/etc/rc.d/rc.libvirt}"
DOCKER_AUTOSTART_FILE="${ZFSAS_MIGRATOR_DOCKER_AUTOSTART_FILE:-/var/lib/docker/unraid-autostart}"
LXC_PLUGIN_CFG="${ZFSAS_MIGRATOR_LXC_PLUGIN_CFG:-/boot/config/plugins/lxc/plugin.cfg}"
LXC_CONF="${ZFSAS_MIGRATOR_LXC_CONF:-/boot/config/plugins/lxc/lxc.conf}"
LXC_STARTUP_SCRIPT="${ZFSAS_MIGRATOR_LXC_STARTUP:-/usr/local/emhttp/plugins/lxc/lxc_scripts/lxc-startup.sh}"
LIBVIRT_AUTOSTART_DIR="${ZFSAS_MIGRATOR_LIBVIRT_AUTOSTART_DIR:-/etc/libvirt/qemu/autostart}"
MIGRATION_TEMP_MARKER=".__migration_tmp__."
INTERRUPTED_MIGRATION_ALERT_SUBJECT="Dataset migration was interrupted"
INTERRUPTED_MIGRATION_ALERT_DESCRIPTION="Dataset migration was interrupted before it finished. Apps may not function properly until the migration completes. Migration will be resumed in about 15 minutes, and apps should begin functioning properly again after that. Until migration is completed, ignore any non-functioning apps caused by the incomplete migration."
RUN_RECOVERY=0
KICK_IF_IDLE=0
IN_PROGRESS_FLAG_PREEXISTED=0
ABSOLUTE_SAFETY_MARGIN=$((1024 * 1024 * 1024))
PERCENT_SAFETY_MARGIN=10
CURRENT_FOLDER_INDEX=-1
ACTIVE_DATASET=""
ACTIVE_MOUNTPOINT=""
ACTIVE_MOUNTPOINT_REAL=""
STATE="preparing"
MESSAGE="Preparing dataset migration."
CURRENT_STEP="preparing"
CURRENT_FOLDER=""
CURRENT_FOLDER_PERCENT=0
OVERALL_PERCENT=0
WAITING_FOR_SPACE=0
WAITING_LABEL=""
WAITING_REQUIRED_BYTES=0
WAITING_AVAILABLE_BYTES=0
STARTED_EPOCH="$(date +%s)"
UPDATED_EPOCH="$STARTED_EPOCH"
ENDED_EPOCH=""
PID="$$"
LAST_ERROR=""
EXIT_CODE=0
MIGRATION_COMPLETE=0
NEEDS_CONTAINER_RECOVERY=0
RESUMING_AFTER_RECOVERY=0
VERIFY_FAILURES_ARE_FATAL=1
STORAGE_ROOTS_CACHE=""
STORAGE_ROOTS_CACHE_KEY="__unset__"
RECOVERY_PHASE=""
RECOVERY_FOLDER_INDEX=-1
RECOVERY_SOURCE_PATH=""
RECOVERY_TEMP_PATH=""
RECOVERY_TARGET_DATASET=""
RECOVERY_BATCH_CONTAINERS=""
RECOVERY_ORIGINAL_NAME=""
NESTED_DECISION=""
NESTED_DECISION_MESSAGE=""
NESTED_UNMOUNTED_FOLDER=""
NESTED_SEP=$'\x1f'

TOTAL_FOLDERS=0
COMPLETED_FOLDERS=0

DATASET=""
CURRENT_BATCH_FOLDERS=""
CURRENT_BATCH_CONTAINERS=""

# Folder state arrays
FOLDER_NAMES=()
FOLDER_SOURCE_PATHS=()
FOLDER_TARGET_DATASETS=()
FOLDER_SIZE_BYTES=()
FOLDER_STATES=()
FOLDER_PROGRESS=()
FOLDER_MESSAGES=()
FOLDER_CONTAINER_INDEXES=()

# Container state arrays
CONTAINER_IDS=()
CONTAINER_NAMES=()
CONTAINER_RESTART_NAMES=()
CONTAINER_RESTART_MAXS=()
CONTAINER_NETWORK_MODES=()
CONTAINER_FOLDER_INDEXES=()
CONTAINER_DEPENDENCY_REFS=()
CONTAINER_DEPENDENCY_INDEXES=()
CONTAINER_WAS_RUNNING=()
CONTAINER_CURRENTLY_RUNNING=()
CONTAINER_POLICY_DISABLED=()
CONTAINER_START_STATES=()
CONTAINER_LAST_ERRORS=()

declare -A FOLDER_INDEX_BY_NAME=()
declare -A CONTAINER_INDEX_BY_NAME=()
declare -A CONTAINER_INDEX_BY_ID=()

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

list_has_word() {
  local list="$1"
  local value="$2"
  local item
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    [[ "$item" == "$value" ]] && return 0
  done <<< "$list"
  return 1
}

list_append_unique() {
  local list="$1"
  local value="$2"
  if [[ -z "$value" ]]; then
    printf '%s' "$list"
    return 0
  fi
  if list_has_word "$list" "$value"; then
    printf '%s' "$list"
    return 0
  fi
  if [[ -n "$list" ]]; then
    printf '%s\n%s' "$list" "$value"
    return 0
  fi
  printf '%s' "$value"
}

list_remove_word() {
  local list="$1"
  local value="$2"
  local item result=""
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    if [[ "$item" == "$value" ]]; then
      continue
    fi
    result="$(list_append_unique "$result" "$item")"
  done <<< "$list"
  printf '%s' "$result"
}

normalize_word_list() {
  printf '%s\n' "$1" | tr '[:space:]' '\n' | sed '/^$/d'
}

log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$(zfsas_log_sanitize_text "$*")"
}

kv_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

sanitize_tsv() {
  local value="$1"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/}"
  printf '%s' "$value"
}

apply_owner() {
  local path="$1"
  chown nobody "$path" >/dev/null 2>&1 || true
  chgrp users "$path" >/dev/null 2>&1 || true
}

ensure_dir() {
  local path="$1"
  mkdir -p "$path"
  chmod 0775 "$path" >/dev/null 2>&1 || true
  apply_owner "$path"
}

write_containers_file() {
  : > "$CONTAINERS_FILE"
  local index
  for index in "${!CONTAINER_IDS[@]}"; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(sanitize_tsv "${CONTAINER_IDS[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_NAMES[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_RESTART_NAMES[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_RESTART_MAXS[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_WAS_RUNNING[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_POLICY_DISABLED[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_START_STATES[$index]}")" \
      "$(sanitize_tsv "${CONTAINER_LAST_ERRORS[$index]}")" \
      >> "$CONTAINERS_FILE"
  done
  chmod 0640 "$CONTAINERS_FILE" >/dev/null 2>&1 || true
  apply_owner "$CONTAINERS_FILE"
}

write_folders_file() {
  : > "$FOLDERS_FILE"
  local index
  for index in "${!FOLDER_NAMES[@]}"; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(sanitize_tsv "${FOLDER_NAMES[$index]}")" \
      "$(sanitize_tsv "${FOLDER_SOURCE_PATHS[$index]}")" \
      "$(sanitize_tsv "${FOLDER_TARGET_DATASETS[$index]}")" \
      "$(sanitize_tsv "${FOLDER_SIZE_BYTES[$index]}")" \
      "$(sanitize_tsv "${FOLDER_STATES[$index]}")" \
      "$(sanitize_tsv "${FOLDER_PROGRESS[$index]}")" \
      "$(sanitize_tsv "${FOLDER_MESSAGES[$index]}")" \
      >> "$FOLDERS_FILE"
  done
  chmod 0640 "$FOLDERS_FILE" >/dev/null 2>&1 || true
  apply_owner "$FOLDERS_FILE"
}

recalculate_overall_percent() {
  if (( TOTAL_FOLDERS <= 0 )); then
    OVERALL_PERCENT=0
    return
  fi

  local percent="$COMPLETED_FOLDERS"
  local current_fraction=0
  if (( CURRENT_FOLDER_INDEX >= 0 )) && [[ "${FOLDER_PROGRESS[$CURRENT_FOLDER_INDEX]:-0}" =~ ^[0-9]+$ ]]; then
    current_fraction="${FOLDER_PROGRESS[$CURRENT_FOLDER_INDEX]}"
  fi

  OVERALL_PERCENT=$(( ((COMPLETED_FOLDERS * 100) + current_fraction) / TOTAL_FOLDERS ))
  if (( OVERALL_PERCENT > 100 )); then
    OVERALL_PERCENT=100
  fi
}

write_status_file() {
  UPDATED_EPOCH="$(date +%s)"
  recalculate_overall_percent
  cat > "$STATUS_FILE" <<EOF
DATASET="$(kv_escape "$ACTIVE_DATASET")"
MOUNTPOINT="$(kv_escape "$ACTIVE_MOUNTPOINT")"
STATE="$(kv_escape "$STATE")"
MESSAGE="$(kv_escape "$MESSAGE")"
CURRENT_STEP="$(kv_escape "$CURRENT_STEP")"
CURRENT_FOLDER="$(kv_escape "$CURRENT_FOLDER")"
CURRENT_FOLDER_PERCENT="$(kv_escape "$CURRENT_FOLDER_PERCENT")"
OVERALL_PERCENT="$(kv_escape "$OVERALL_PERCENT")"
TOTAL_FOLDERS="$(kv_escape "$TOTAL_FOLDERS")"
COMPLETED_FOLDERS="$(kv_escape "$COMPLETED_FOLDERS")"
WAITING_FOR_SPACE="$(kv_escape "$WAITING_FOR_SPACE")"
WAITING_LABEL="$(kv_escape "$WAITING_LABEL")"
WAITING_REQUIRED_BYTES="$(kv_escape "$WAITING_REQUIRED_BYTES")"
WAITING_AVAILABLE_BYTES="$(kv_escape "$WAITING_AVAILABLE_BYTES")"
PID="$(kv_escape "$PID")"
STARTED_EPOCH="$(kv_escape "$STARTED_EPOCH")"
UPDATED_EPOCH="$(kv_escape "$UPDATED_EPOCH")"
ENDED_EPOCH="$(kv_escape "$ENDED_EPOCH")"
LAST_ERROR="$(kv_escape "$LAST_ERROR")"
LOG_FILE="$(kv_escape "$LOG_FILE")"
EOF
  chmod 0640 "$STATUS_FILE" >/dev/null 2>&1 || true
  apply_owner "$STATUS_FILE"
  write_folders_file
  write_containers_file
}

write_recovery_state() {
  [[ -n "$RECOVERY_TEMP_PATH" || -n "$RECOVERY_TARGET_DATASET" ]] || return 0
  cat > "$RECOVERY_STATE_FILE" <<EOF
RECOVERY_PHASE="$(kv_escape "$RECOVERY_PHASE")"
RECOVERY_FOLDER_INDEX="$(kv_escape "$RECOVERY_FOLDER_INDEX")"
RECOVERY_SOURCE_PATH="$(kv_escape "$RECOVERY_SOURCE_PATH")"
RECOVERY_TEMP_PATH="$(kv_escape "$RECOVERY_TEMP_PATH")"
RECOVERY_TARGET_DATASET="$(kv_escape "$RECOVERY_TARGET_DATASET")"
RECOVERY_BATCH_CONTAINERS="$(kv_escape "$RECOVERY_BATCH_CONTAINERS")"
RECOVERY_ORIGINAL_NAME="$(kv_escape "$RECOVERY_ORIGINAL_NAME")"
DATASET="$(kv_escape "$ACTIVE_DATASET")"
STARTED_EPOCH="$(kv_escape "$STARTED_EPOCH")"
UPDATED_EPOCH="$(date +%s)"
EOF
  chmod 0640 "$RECOVERY_STATE_FILE" >/dev/null 2>&1 || true
  apply_owner "$RECOVERY_STATE_FILE"
}

clear_recovery_state() {
  RECOVERY_PHASE=""
  RECOVERY_FOLDER_INDEX=-1
  RECOVERY_SOURCE_PATH=""
  RECOVERY_TEMP_PATH=""
  RECOVERY_TARGET_DATASET=""
  RECOVERY_BATCH_CONTAINERS=""
  RECOVERY_ORIGINAL_NAME=""
  rm -f -- "$RECOVERY_STATE_FILE" "$RECOVERY_ALERT_STAMP" >/dev/null 2>&1 || true
}

load_tsv_state_for_recovery() {
  local line index name source_path target_ds size state progress message
  FOLDER_NAMES=()
  FOLDER_SOURCE_PATHS=()
  FOLDER_TARGET_DATASETS=()
  FOLDER_SIZE_BYTES=()
  FOLDER_STATES=()
  FOLDER_PROGRESS=()
  FOLDER_MESSAGES=()
  FOLDER_CONTAINER_INDEXES=()
  FOLDER_INDEX_BY_NAME=()
  if [[ -r "$FOLDERS_FILE" ]]; then
    while IFS=$'\t' read -r name source_path target_ds size state progress message; do
      [[ -n "${name:-}" ]] || continue
      index="${#FOLDER_NAMES[@]}"
      FOLDER_NAMES+=("$name")
      FOLDER_SOURCE_PATHS+=("$source_path")
      FOLDER_TARGET_DATASETS+=("$target_ds")
      FOLDER_SIZE_BYTES+=("$size")
      FOLDER_STATES+=("${state:-queued}")
      FOLDER_PROGRESS+=("${progress:-0}")
      FOLDER_MESSAGES+=("${message:-Queued for migration.}")
      FOLDER_CONTAINER_INDEXES+=("")
      FOLDER_INDEX_BY_NAME["$name"]="$index"
    done < "$FOLDERS_FILE"
  fi
  TOTAL_FOLDERS="${#FOLDER_NAMES[@]}"

  CONTAINER_IDS=()
  CONTAINER_NAMES=()
  CONTAINER_RESTART_NAMES=()
  CONTAINER_RESTART_MAXS=()
  CONTAINER_NETWORK_MODES=()
  CONTAINER_FOLDER_INDEXES=()
  CONTAINER_DEPENDENCY_REFS=()
  CONTAINER_DEPENDENCY_INDEXES=()
  CONTAINER_WAS_RUNNING=()
  CONTAINER_CURRENTLY_RUNNING=()
  CONTAINER_POLICY_DISABLED=()
  CONTAINER_START_STATES=()
  CONTAINER_LAST_ERRORS=()
  CONTAINER_INDEX_BY_NAME=()
  CONTAINER_INDEX_BY_ID=()
  if [[ -r "$CONTAINERS_FILE" ]]; then
    local id cname policy max was_running policy_disabled start_state last_error container_index
    while IFS=$'\t' read -r id cname policy max was_running policy_disabled start_state last_error; do
      [[ -n "${id:-}" ]] || continue
      container_index="${#CONTAINER_IDS[@]}"
      CONTAINER_IDS+=("$id")
      CONTAINER_NAMES+=("$cname")
      CONTAINER_RESTART_NAMES+=("${policy:-no}")
      CONTAINER_RESTART_MAXS+=("${max:-0}")
      CONTAINER_NETWORK_MODES+=("default")
      CONTAINER_FOLDER_INDEXES+=("")
      CONTAINER_DEPENDENCY_REFS+=("")
      CONTAINER_DEPENDENCY_INDEXES+=("")
      CONTAINER_WAS_RUNNING+=("${was_running:-1}")
      CONTAINER_CURRENTLY_RUNNING+=("1")
      CONTAINER_POLICY_DISABLED+=("${policy_disabled:-0}")
      CONTAINER_START_STATES+=("${start_state:-recovery_pending}")
      CONTAINER_LAST_ERRORS+=("${last_error:-}")
      CONTAINER_INDEX_BY_NAME["$cname"]="$container_index"
      CONTAINER_INDEX_BY_ID["$id"]="$container_index"
    done < "$CONTAINERS_FILE"
  fi
}

load_recovery_state() {
  [[ -r "$RECOVERY_STATE_FILE" ]] || return 1
  RECOVERY_ORIGINAL_NAME=""
  # shellcheck source=/dev/null
  source "$RECOVERY_STATE_FILE"
  ACTIVE_DATASET="${DATASET:-$ACTIVE_DATASET}"
  RECOVERY_BATCH_CONTAINERS="$(normalize_word_list "${RECOVERY_BATCH_CONTAINERS:-}")"
  load_tsv_state_for_recovery
  return 0
}

normalize_state_token() {
  local value="$1"
  value="$(trim "$value")"
  value="${value%\"}"
  value="${value#\"}"
  value="${value,,}"
  printf '%s' "$value"
}

state_token_is_actionable() {
  case "$(normalize_state_token "$1")" in
    1|yes|true|started|started_mounted|mounted|array_started|array_started_mounted|running)
      return 0
      ;;
  esac
  return 1
}

state_token_is_not_actionable() {
  case "$(normalize_state_token "$1")" in
    0|no|false|stopped|stopping|starting|shutdown|shutting_down|array_stopped|array_stopping|array_starting)
      return 0
      ;;
  esac
  return 1
}

migration_host_ready() {
  local status_text key value
  status_text="$(get_unraid_array_status 2>/dev/null || true)"
  [[ -n "$status_text" ]] || return 0
  for key in mdState fsState sbState started; do
    value="$(extract_status_value "$key" <<< "$status_text" || true)"
    [[ -n "$value" ]] || continue
    if state_token_is_actionable "$value"; then
      return 0
    fi
    if state_token_is_not_actionable "$value"; then
      return 1
    fi
  done
  return 0
}

notify_interrupted_migration() {
  local subject="$INTERRUPTED_MIGRATION_ALERT_SUBJECT"
  local description="$INTERRUPTED_MIGRATION_ALERT_DESCRIPTION"
  local notify_bin=""
  ensure_dir "$(dirname "$RECOVERY_ALERT_STAMP")"
  if ! (set -o noclobber; printf '%s\n' "$(date +%s)" > "$RECOVERY_ALERT_STAMP") 2>/dev/null; then
    return 0
  fi
  log "Unraid alert: ${subject} — ${description}"
  notify_bin="${ZFSAS_NOTIFY_BIN:-}"
  if [[ -z "$notify_bin" ]]; then
    if [[ -x /usr/local/emhttp/webGui/scripts/notify ]]; then
      notify_bin="/usr/local/emhttp/webGui/scripts/notify"
    elif command -v notify >/dev/null 2>&1; then
      notify_bin="$(command -v notify)"
    fi
  fi
  if [[ -n "$notify_bin" && -x "$notify_bin" ]]; then
    "$notify_bin" \
      -e "ZFS Auto Snapshot Dataset Migration" \
      -s "$subject" \
      -d "$description" \
      -m "$description" \
      -i "alert" || log "Unraid notify command failed."
    return 0
  fi
  if [[ -f /usr/local/emhttp/webGui/include/Notifications.php ]] && command -v php >/dev/null 2>&1; then
    ZFSAS_ALERT_EVENT="ZFS Auto Snapshot Dataset Migration" \
      ZFSAS_ALERT_SUBJECT="$subject" \
      ZFSAS_ALERT_DESCRIPTION="$description" \
      php -r '
        require_once "/usr/local/emhttp/webGui/include/Notifications.php";
        if (!class_exists("Notifications")) { exit(0); }
        $notifications = new Notifications();
        $notifications->notify(getenv("ZFSAS_ALERT_EVENT"), getenv("ZFSAS_ALERT_SUBJECT"), getenv("ZFSAS_ALERT_DESCRIPTION"), getenv("ZFSAS_ALERT_DESCRIPTION"), "alert");
      ' || log "Unraid Notifications.php alert failed."
    return 0
  fi
  log "Unraid notify is unavailable. The interruption alert was recorded in the migrator log only."
}

write_in_progress_flag() {
  [[ -n "$ACTIVE_DATASET" ]] || return 0
  cat > "$IN_PROGRESS_FLAG" <<EOF
DATASET="$(kv_escape "$ACTIVE_DATASET")"
STARTED_EPOCH="$(kv_escape "$STARTED_EPOCH")"
PID="$(kv_escape "$$")"
EOF
  chmod 0640 "$IN_PROGRESS_FLAG" >/dev/null 2>&1 || true
  apply_owner "$IN_PROGRESS_FLAG"
}

clear_in_progress_flag() {
  rm -f -- "$IN_PROGRESS_FLAG" >/dev/null 2>&1 || true
}

read_in_progress_dataset() {
  local line value
  [[ -r "$IN_PROGRESS_FLAG" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^DATASET=\"(.*)\"$ ]] || continue
    value="${BASH_REMATCH[1]}"
    value="${value//\\\"/\"}"
    value="${value//\\\\/\\}"
    printf '%s' "$value"
    return 0
  done < "$IN_PROGRESS_FLAG"
  return 1
}

migration_temp_name() {
  local name="$1"
  printf '%s' "${name}${MIGRATION_TEMP_MARKER}$(date +%s).$$.$RANDOM"
}

original_name_from_migration_temp() {
  local base="$1"
  local prefix suffix
  [[ "$base" == *"$MIGRATION_TEMP_MARKER"* ]] || return 1
  prefix="${base%%"$MIGRATION_TEMP_MARKER"*}"
  suffix="${base#*"$MIGRATION_TEMP_MARKER"}"
  [[ -n "$prefix" && "$prefix" != "$base" ]] || return 1
  [[ "$suffix" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$prefix" =~ ^[A-Za-z0-9._:+\-]+$ ]] || return 1
  printf '%s' "$prefix"
}

discover_leftover_temp_recovery() {
  local mountpoint child name original target_dataset
  [[ -n "$ACTIVE_DATASET" ]] || return 1
  [[ -e "$RECOVERY_STATE_FILE" ]] && return 1
  mountpoint="$(zfs get -H -o value mountpoint "$ACTIVE_DATASET" 2>/dev/null | head -n 1 || true)"
  [[ -n "$mountpoint" && "$mountpoint" != "legacy" && "$mountpoint" != "none" && -d "$mountpoint" ]] || return 1
  while IFS= read -r -d '' child; do
    name="$(basename "$child")"
    original="$(original_name_from_migration_temp "$name" || true)"
    [[ -n "$original" ]] || continue
    if handled_folder_record "$original" >/dev/null 2>&1; then
      log "Preserved temp folder '$name' belongs to '$original', which is already skipped or failed. Leaving that temp folder in place."
      continue
    fi
    target_dataset="${ACTIVE_DATASET}/${original}"
    RECOVERY_PHASE="renamed_source"
    if dataset_exists "$target_dataset"; then
      RECOVERY_PHASE="dataset_created"
    fi
    RECOVERY_FOLDER_INDEX="-1"
    RECOVERY_SOURCE_PATH="${mountpoint}/${original}"
    RECOVERY_TEMP_PATH="$child"
    RECOVERY_TARGET_DATASET="$target_dataset"
    RECOVERY_ORIGINAL_NAME="$original"
    RECOVERY_BATCH_CONTAINERS="${RECOVERY_BATCH_CONTAINERS:-}"
    write_recovery_state
    log "Recognized incomplete migration temp folder '$name' as original folder '$original'."
    return 0
  done < <(find "$mountpoint" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
  return 1
}

migrator_lock_is_held() {
  ensure_dir "$(dirname "$LOCK_FILE")"
  if (
    flock -n 8
  ) 8>"$LOCK_FILE"; then
    return 1
  fi
  return 0
}

spawn_migrator() {
  local arg line=""
  if [[ -n "${ZFSAS_MIGRATOR_SPAWN_LOG:-}" ]]; then
    for arg in "$@"; do
      line+="${line:+ }${arg}"
    done
    printf '%s\n' "$line" >> "$ZFSAS_MIGRATOR_SPAWN_LOG"
    return 0
  fi
  nohup "$0" "$@" >/dev/null 2>&1 &
}

kick_pending_migration() {
  local dataset=""
  if [[ -s "$(restart_policy_pending_file)" ]]; then
    if migrator_lock_is_held; then
      log "Saved restart policies still need restoring, but the migrator is already running."
    else
      restore_restart_policies_left_disabled || true
    fi
  fi
  if ! migration_host_ready; then
    log "Dataset migration kicker is waiting for the array before resuming an interrupted migration."
    return 0
  fi
  if [[ ! -e "$RECOVERY_STATE_FILE" && ! -e "$IN_PROGRESS_FLAG" ]]; then
    return 0
  fi
  if migrator_lock_is_held; then
    log "Dataset migration kicker found pending migration state, but the migrator is already running."
    return 0
  fi
  if [[ -e "$RECOVERY_STATE_FILE" ]]; then
    notify_interrupted_migration
    spawn_migrator --recover-pending
    log "Dataset migration kicker started delayed recovery."
    return 0
  fi
  dataset="$(read_in_progress_dataset || true)"
  [[ -n "$dataset" ]] || return 0
  spawn_migrator --dataset "$dataset"
  log "Dataset migration kicker restarted dataset migration for $dataset."
  return 0
}

set_status() {
  STATE="$1"
  CURRENT_STEP="$2"
  MESSAGE="$3"
  write_status_file
}

set_waiting_for_space() {
  WAITING_FOR_SPACE=1
  WAITING_LABEL="$1"
  WAITING_REQUIRED_BYTES="$2"
  WAITING_AVAILABLE_BYTES="$3"
  STATE="waiting_for_space"
  CURRENT_STEP="waiting_for_space"
  MESSAGE="Free space is too low for ${WAITING_LABEL}. Free up space and the migration will continue automatically."
  write_status_file
}

clear_waiting_for_space() {
  WAITING_FOR_SPACE=0
  WAITING_LABEL=""
  WAITING_REQUIRED_BYTES=0
  WAITING_AVAILABLE_BYTES=0
}

folder_set() {
  local index="$1"
  local state="$2"
  local progress="$3"
  local message="$4"
  if [[ ! "$index" =~ ^[0-9]+$ ]]; then
    write_status_file
    return 0
  fi
  FOLDER_STATES[index]="$state"
  FOLDER_PROGRESS[index]="$progress"
  FOLDER_MESSAGES[index]="$message"
  if (( index == CURRENT_FOLDER_INDEX )); then
    CURRENT_FOLDER="${FOLDER_NAMES[index]}"
    CURRENT_FOLDER_PERCENT="$progress"
  fi
  write_status_file
}

die() {
  LAST_ERROR="$1"
  log "FATAL: $LAST_ERROR"
  EXIT_CODE=1
  return 1
}

note_folder_error() {
  LAST_ERROR="$1"
  log "$LAST_ERROR"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  for cmd in zfs rsync find sha256sum sort cmp awk sed flock sync mv rm readlink stat du wc grep sleep date dirname basename touch docker shutdown cat chown chmod ps dd; do
    require_cmd "$cmd"
  done

  [[ "$(id -u)" -eq 0 ]] || die "Must be run as root"
fi

find_mdcmd() {
  if command -v mdcmd >/dev/null 2>&1; then
    command -v mdcmd
    return 0
  fi
  [[ -x /root/mdcmd ]] || return 1
  printf '/root/mdcmd\n'
}

extract_status_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key { print $2; exit }'
}

get_unraid_array_status() {
  local mdcmd_bin
  if mdcmd_bin="$(find_mdcmd 2>/dev/null)"; then
    "$mdcmd_bin" status
    return 0
  fi
  if [[ -r /proc/mdcmd ]]; then
    cat /proc/mdcmd
    return 0
  fi
  if [[ -r "${ZFSAS_UNRAID_VAR_INI:-/var/local/emhttp/var.ini}" ]]; then
    cat "${ZFSAS_UNRAID_VAR_INI:-/var/local/emhttp/var.ini}"
    return 0
  fi
  return 1
}

parity_sync_in_progress() {
  local status_text mdresync mdaction mdstat_line
  status_text="$(get_unraid_array_status 2>/dev/null || true)"
  if [[ -n "$status_text" ]]; then
    mdresync="$(extract_status_value "mdResync" <<< "$status_text" || true)"
    mdaction="$(extract_status_value "mdResyncAction" <<< "$status_text" || true)"
    if [[ "$mdresync" =~ ^[0-9]+$ ]] && (( mdresync > 0 )); then
      log "Detected array sync activity: mdResync=$mdresync mdResyncAction='${mdaction:-unknown}'"
      return 0
    fi
    return 1
  fi
  mdstat_line="$(grep -m 1 -E '(^|[[:space:]])(resync|recovery|reshape|check)[[:space:]]*=' /proc/mdstat 2>/dev/null || true)"
  if [[ -n "$mdstat_line" ]]; then
    log "Detected array sync activity from /proc/mdstat fallback: $mdstat_line"
    return 0
  fi
  return 1
}

mover_process_matches() {
  local args="$1"
  [[ "$args" == *"/usr/local/sbin/mover"* ]] || [[ "$args" == *"/usr/local/bin/mover"* ]]
}

mover_is_running() {
  local pidfile="/var/run/mover.pid"
  local pid args line
  if [[ -r "$pidfile" ]]; then
    pid="$(<"$pidfile")"
    pid="${pid//[[:space:]]/}"
    if [[ "$pid" =~ ^[0-9]+$ ]]; then
      args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
      if [[ -n "$args" ]] && mover_process_matches "$args"; then
        log "Detected running mover via $pidfile: pid=$pid args=$args"
        return 0
      fi
    fi
  fi
  while IFS= read -r line; do
    IFS=' ' read -r pid args <<< "$line"
    if [[ -n "$args" ]] && mover_process_matches "$args"; then
      log "Detected running mover via process list: pid=$pid args=$args"
      return 0
    fi
  done < <(ps -eo pid=,args= 2>/dev/null)
  return 1
}

dataset_exists() {
  local ds="$1"
  zfs list -H -o name "$ds" >/dev/null 2>&1
}

dataset_mounted_at_path() {
  local path="$1"
  zfs list -H -t filesystem -o name,mountpoint 2>/dev/null | awk -F '\t' -v target="$path" '$2 == target { print $1; exit }'
}

get_pool_name() {
  printf '%s\n' "${ACTIVE_DATASET%%/*}"
}

get_pool_available_bytes() {
  zfs list -H -p -o avail "$(get_pool_name)" | awk 'NR==1 {print $1}'
}

get_directory_used_bytes() {
  local dir="$1"
  du -skx -- "$dir" | awk '{print $1 * 1024}'
}

calculate_required_free_bytes() {
  local source_bytes="$1"
  local percent_margin safety_margin
  percent_margin=$(( source_bytes * PERCENT_SAFETY_MARGIN / 100 ))
  if (( percent_margin >= ABSOLUTE_SAFETY_MARGIN )); then
    safety_margin="$percent_margin"
  else
    safety_margin="$ABSOLUTE_SAFETY_MARGIN"
  fi
  echo $(( source_bytes + safety_margin ))
}

wait_for_free_space() {
  local required_bytes="$1"
  local label="$2"
  local folder_index="$3"
  local avail attempt=0

  while true; do
    avail="$(get_pool_available_bytes)"
    [[ "$avail" =~ ^[0-9]+$ ]] || { note_folder_error "Unable to read available space from ZFS pool $(get_pool_name)"; return 1; }
    if (( avail >= required_bytes )); then
      clear_waiting_for_space
      return 0
    fi
    attempt=$(( attempt + 1 ))
    if (( folder_index >= 0 )); then
      folder_set "$folder_index" "waiting_for_space" "${FOLDER_PROGRESS[$folder_index]:-0}" "Waiting for free space before continuing."
    fi
    set_waiting_for_space "$label" "$required_bytes" "$avail"
    log "Insufficient free space for '$label' (attempt $attempt): required=${required_bytes} avail=${avail}"
    sleep "$SPACE_RECHECK_SECONDS"
  done
}

preflight_space_for_folder() {
  local folder_index="$1"
  local name="${FOLDER_NAMES[$folder_index]}"
  local source_bytes="${FOLDER_SIZE_BYTES[$folder_index]:-0}"
  local required_bytes

  if [[ ! "$source_bytes" =~ ^[0-9]+$ ]] || (( source_bytes <= 0 )); then
    source_bytes="$(get_directory_used_bytes "${FOLDER_SOURCE_PATHS[$folder_index]}")"
    [[ "$source_bytes" =~ ^[0-9]+$ ]] || { note_folder_error "Could not determine source size for '${FOLDER_SOURCE_PATHS[$folder_index]}'"; return 1; }
    FOLDER_SIZE_BYTES[folder_index]="$source_bytes"
    write_status_file
  fi

  required_bytes="$(calculate_required_free_bytes "$source_bytes")"
  folder_set "$folder_index" "checking_space" "0" "Checking free space before stopping containers or moving this folder."
  wait_for_free_space "$required_bytes" "$name" "$folder_index"
}

wait_for_resume_space() {
  local label="$1"
  local folder_index="$2"
  local avail
  while true; do
    avail="$(get_pool_available_bytes)"
    [[ "$avail" =~ ^[0-9]+$ ]] || { note_folder_error "Unable to read available space from ZFS pool $(get_pool_name)"; return 1; }
    if (( avail >= ABSOLUTE_SAFETY_MARGIN )); then
      clear_waiting_for_space
      return 0
    fi
    if (( folder_index >= 0 )); then
      folder_set "$folder_index" "waiting_for_space" "${FOLDER_PROGRESS[$folder_index]:-0}" "Copy paused because the pool ran out of free space."
    fi
    set_waiting_for_space "$label" "$ABSOLUTE_SAFETY_MARGIN" "$avail"
    log "Copy paused for low free space on '$label': need at least ${ABSOLUTE_SAFETY_MARGIN} bytes free to retry, avail=${avail}"
    sleep "$SPACE_RECHECK_SECONDS"
  done
}

socket_path_is_active() {
  local socket_path="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -xanH 2>/dev/null | awk -v target="$socket_path" '$NF == target { found=1 } END { exit found ? 0 : 1 }'
    return $?
  fi
  if command -v netstat >/dev/null 2>&1; then
    netstat -xan 2>/dev/null | awk -v target="$socket_path" '$NF == target { found=1 } END { exit found ? 0 : 1 }'
    return $?
  fi
  return 1
}

prepare_sockets_for_migration() {
  local dir="$1"
  local socket_path active_found=0 removed_any=0
  while IFS= read -r -d '' socket_path; do
    if socket_path_is_active "$socket_path"; then
      if (( active_found == 0 )); then
        log "Active socket files are still present under '$dir':"
        active_found=1
      fi
      log "$socket_path"
      continue
    fi
    log "Removing stale socket file: $socket_path"
    rm -f -- "$socket_path"
    removed_any=1
  done < <(find "$dir" -xdev -type s -print0 2>/dev/null)

  if (( removed_any == 1 )); then
    log "Removed stale socket files under '$dir'."
  fi

  if (( active_found == 1 )); then
    return 1
  fi
  return 0
}

mountinfo_path() {
  printf '%s' "${ZFSAS_MIGRATOR_MOUNTINFO:-/proc/self/mountinfo}"
}

proc_root() {
  printf '%s' "${ZFSAS_MIGRATOR_PROC_ROOT:-/proc}"
}

nested_mount_root() {
  printf '%s' "${ZFSAS_MIGRATOR_NESTED_MOUNT_DIR:-${PLUGIN_ROOT}/nested-mounts}"
}

nested_plan_dir() {
  local name="$1"
  printf '%s' "$(nested_mount_root)/${name}"
}

nested_plan_file() {
  local name="$1"
  printf '%s' "$(nested_plan_dir "$name")/mounts.tsv"
}

nested_retry_delay() {
  local delay="${ZFSAS_MIGRATOR_UNMOUNT_RETRY_DELAY:-1}"
  [[ "$delay" =~ ^[0-9]+$ ]] || delay=1
  printf '%s' "$delay"
}

clear_nested_plan() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9._:+\-]+$ ]] || return 0
  rm -rf -- "$(nested_plan_dir "$name")"
}

nested_record() {
  local IFS="$NESTED_SEP"
  printf '%s\n' "$*"
}

unescape_mount_field() {
  local value="$1" out="" char oct
  local -i i len
  len="${#value}"
  for (( i = 0; i < len; i++ )); do
    char="${value:i:1}"
    if [[ "$char" == '\' ]]; then
      oct="${value:i+1:3}"
      if [[ "$oct" =~ ^[0-7]{3}$ ]]; then
        printf -v char '%b' "\\${oct}"
        i=$((i + 3))
      fi
    fi
    out+="$char"
  done
  printf '%s' "$out"
}

parse_mountinfo_line() {
  local line="$1"
  local -a fields=()
  local i sep_at=-1 mountpoint fstype source vfs fsopts root major_minor
  # The migrator keeps IFS as newline/tab. Mountinfo fields are space-separated.
  local IFS=$' \t'
  read -r -a fields <<< "$line"
  (( ${#fields[@]} >= 10 )) || return 1
  for i in "${!fields[@]}"; do
    if [[ "${fields[$i]}" == "-" ]]; then
      sep_at="$i"
      break
    fi
  done
  (( sep_at >= 6 && sep_at + 3 < ${#fields[@]} )) || return 1
  mountpoint="$(unescape_mount_field "${fields[4]}")"
  vfs="$(unescape_mount_field "${fields[5]}")"
  root="$(unescape_mount_field "${fields[3]}")"
  fstype="$(unescape_mount_field "${fields[sep_at + 1]}")"
  source="$(unescape_mount_field "${fields[sep_at + 2]}")"
  fsopts="$(unescape_mount_field "${fields[sep_at + 3]}")"
  major_minor="${fields[2]}"
  nested_record \
    "$(sanitize_tsv "$mountpoint")" \
    "$(sanitize_tsv "$fstype")" \
    "$(sanitize_tsv "$source")" \
    "$(sanitize_tsv "$vfs")" \
    "$(sanitize_tsv "$fsopts")" \
    "$(sanitize_tsv "$root")" \
    "$(sanitize_tsv "$major_minor")"
}

findmnt_field() {
  local line="$1" key="$2"
  if [[ "$line" =~ ${key}=\"([^\"]*)\" ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  printf ''
}

list_mountinfo_records() {
  local mountinfo line target fstype source vfs fsopts root major tmp status
  mountinfo="$(mountinfo_path)"
  if [[ -r "$mountinfo" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -n "$line" ]] || continue
      parse_mountinfo_line "$line" || true
    done < "$mountinfo"
    return 0
  fi
  command -v findmnt >/dev/null 2>&1 || return 1
  tmp="$(mktemp)"
  set +e
  findmnt -n -P -o TARGET,FSTYPE,SOURCE,VFS-OPTIONS,FS-OPTIONS,FSROOT,MAJ:MIN >"$tmp" 2>/dev/null
  status=$?
  set -e
  if (( status != 0 )); then
    rm -f -- "$tmp"
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    target="$(findmnt_field "$line" TARGET)"
    fstype="$(findmnt_field "$line" FSTYPE)"
    source="$(findmnt_field "$line" SOURCE)"
    vfs="$(findmnt_field "$line" VFS-OPTIONS)"
    fsopts="$(findmnt_field "$line" FS-OPTIONS)"
    root="$(findmnt_field "$line" FSROOT)"
    major="$(findmnt_field "$line" "MAJ:MIN")"
    [[ -n "$target" ]] || continue
    nested_record \
      "$(sanitize_tsv "$target")" \
      "$(sanitize_tsv "$fstype")" \
      "$(sanitize_tsv "$source")" \
      "$(sanitize_tsv "$vfs")" \
      "$(sanitize_tsv "$fsopts")" \
      "$(sanitize_tsv "${root:-/}")" \
      "$(sanitize_tsv "$major")"
  done < "$tmp"
  rm -f -- "$tmp"
  return 0
}

path_is_strict_child() {
  local parent child
  parent="$(normalize_abs_path "$1")"
  child="$(normalize_abs_path "$2")"
  [[ -n "$parent" && "$parent" != "/" && -n "$child" ]] || return 1
  [[ "$child" == "$parent"/* ]]
}

canonical_mount_path() {
  local path
  path="$(normalize_abs_path "$(canonicalize_host_path "$1")")"
  printf '%s' "$path"
}

folder_has_live_nested_mount() {
  local dir="$1" records canon record mountpoint
  if ! records="$(list_mountinfo_records)"; then
    return 0
  fi
  canon="$(canonical_mount_path "$dir")"
  [[ -n "$canon" && "$canon" != "/" ]] || return 1
  while IFS= read -r record || [[ -n "$record" ]]; do
    [[ -n "$record" ]] || continue
    mountpoint="$(canonical_mount_path "${record%%"$NESTED_SEP"*}")"
    if path_is_strict_child "$canon" "$mountpoint"; then
      return 0
    fi
  done <<< "$records"
  return 1
}

path_is_mounted() {
  local target records record mountpoint
  target="$(canonical_mount_path "$1")"
  [[ -n "$target" ]] || return 1
  if ! records="$(list_mountinfo_records)"; then
    return 1
  fi
  while IFS= read -r record || [[ -n "$record" ]]; do
    [[ -n "$record" ]] || continue
    mountpoint="$(canonical_mount_path "${record%%"$NESTED_SEP"*}")"
    [[ "$mountpoint" == "$target" ]] && return 0
  done <<< "$records"
  return 1
}

fstype_is_zfs() {
  local fstype="${1,,}"
  [[ "$fstype" == "zfs" ]]
}

fstype_is_pseudo() {
  local fstype="${1,,}"
  case "$fstype" in
    autofs|proc|sysfs|devtmpfs|devpts|cgroup|cgroup2|securityfs|pstore|bpf|tracefs|debugfs|hugetlbfs|mqueue|configfs|fusectl|binfmt_misc|rpc_pipefs|nfsd)
      return 0
      ;;
  esac
  return 1
}

fstype_is_fuse() {
  local fstype="${1,,}"
  [[ "$fstype" == "fuse" || "$fstype" == fuse.* ]]
}

mount_helper_available() {
  local fstype="$1" helper
  if [[ -n "${ZFSAS_MIGRATOR_MOUNT_HELPER_DIR:-}" && -x "${ZFSAS_MIGRATOR_MOUNT_HELPER_DIR}/mount.${fstype}" ]]; then
    return 0
  fi
  if command -v "mount.${fstype}" >/dev/null 2>&1; then
    return 0
  fi
  for helper in /sbin /usr/sbin /bin /usr/bin; do
    [[ -x "${helper}/mount.${fstype}" ]] && return 0
  done
  return 1
}

merge_mount_options() {
  local vfs="$1" fs="$2" part out=""
  local -a parts=()
  IFS=',' read -r -a parts <<< "${vfs},${fs}"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    case ",${out}," in
      *,"${part}",*) continue ;;
    esac
    out="${out:+${out},}${part}"
  done
  printf '%s' "$out"
}

command_is_mount_helper() {
  local comm="$1" fstype="$2" suffix=""
  case "${fstype,,}" in
    fuse.*) suffix="${fstype#*.}" ;;
  esac
  suffix="${suffix%%.*}"
  case "$comm" in
    rclone|sshfs|mergerfs|mount|fusermount|fusermount3|unionfs|unionfs-fuse|bindfs|curlftpfs|s3fs|gocryptfs|borg)
      return 0
      ;;
  esac
  [[ -n "$suffix" && "$comm" == "$suffix" ]]
}

discover_mount_command() {
  local mountpoint="$1" fstype="$2" dest_file="$3"
  local root comm_file pid comm arg found hash unique_hash="" candidate
  local canon_target canon_arg
  root="$(proc_root)"
  [[ -d "$root" ]] || return 1
  canon_target="$(canonical_mount_path "$mountpoint")"
  [[ -n "$canon_target" ]] || return 1
  candidate="$(mktemp)"
  for comm_file in "$root"/[0-9]*/comm; do
    [[ -r "$comm_file" ]] || continue
    pid="${comm_file%/comm}"
    pid="${pid##*/}"
    comm="$(tr -d '[:space:]' < "$comm_file" || true)"
    command_is_mount_helper "$comm" "$fstype" || continue
    [[ -r "$root/$pid/cmdline" ]] || continue
    found=0
    while IFS= read -r -d '' arg || [[ -n "$arg" ]]; do
      [[ -n "$arg" ]] || continue
      [[ "$arg" == /* ]] || continue
      canon_arg="$(canonical_mount_path "$arg")"
      if [[ "$canon_arg" == "$canon_target" ]]; then
        found=1
        break
      fi
    done < "$root/$pid/cmdline"
    (( found == 1 )) || continue
    hash="$(sha256sum "$root/$pid/cmdline" | awk '{print $1}')"
    if [[ -z "$unique_hash" ]]; then
      unique_hash="$hash"
      cp -- "$root/$pid/cmdline" "$candidate"
    elif [[ "$unique_hash" != "$hash" ]]; then
      rm -f -- "$candidate"
      return 1
    fi
  done
  if [[ -z "$unique_hash" ]]; then
    rm -f -- "$candidate"
    return 1
  fi
  mv -- "$candidate" "$dest_file"
  return 0
}

resolve_bind_host_path() {
  local major_minor="$1" root_in_fs="$2"
  local records record mountpoint fstype source vfs fsopts root major candidate
  [[ -n "$root_in_fs" && "$root_in_fs" != "/" ]] || return 1
  if ! records="$(list_mountinfo_records)"; then
    return 1
  fi
  while IFS= read -r record || [[ -n "$record" ]]; do
    [[ -n "$record" ]] || continue
    IFS="$NESTED_SEP" read -r mountpoint fstype source vfs fsopts root major <<< "$record"
    [[ "$major" == "$major_minor" && "$root" == "/" ]] || continue
    candidate="$(normalize_abs_path "${mountpoint}${root_in_fs}")"
    if [[ -e "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done <<< "$records"
  return 1
}

emit_nested_decision() {
  local mode="$1" options="$2" bind_source="$3" argv_name="$4" message="$5"
  message="${message//$'\n'/ }"
  message="${message//$'\t'/ }"
  message="${message//"$NESTED_SEP"/ }"
  nested_record "$mode" "$options" "$bind_source" "$argv_name" "$message"
}

plan_one_nested_mount() {
  local mountpoint="$1" fstype="$2" source="$3" vfs="$4" fsopts="$5" root="$6" major="$7" argv_file="$8"
  local options="" bind_source="" message=""
  if fstype_is_zfs "$fstype"; then
    message="Nested ZFS dataset '${source:-unknown}' is mounted at '${mountpoint}'. A parent dataset is not created over a live child mount."
    emit_nested_decision "skip-zfs" "" "" "" "$message"
    return 0
  fi
  if fstype_is_pseudo "$fstype"; then
    message="Nested ${fstype} mount at '${mountpoint}' cannot be unmounted and remounted safely."
    emit_nested_decision "skip-unsafe" "" "" "" "$message"
    return 0
  fi
  options="$(merge_mount_options "$vfs" "$fsopts")"
  if [[ "$root" != "/" && -n "$root" ]]; then
    bind_source="$(resolve_bind_host_path "$major" "$root" || true)"
    if [[ -n "$bind_source" ]]; then
      emit_nested_decision "bind" "$options" "$bind_source" "" ""
      return 0
    fi
  fi
  if discover_mount_command "$mountpoint" "$fstype" "$argv_file"; then
    emit_nested_decision "command" "$options" "" "$(basename -- "$argv_file")" ""
    return 0
  fi
  if fstype_is_fuse "$fstype"; then
    if [[ -n "$source" && "$source" != "none" ]] && mount_helper_available "$fstype"; then
      emit_nested_decision "mount" "$options" "" "" ""
      return 0
    fi
    message="Nested ${fstype} mount at '${mountpoint}' has no reliable remount command. The folder was left unchanged."
    emit_nested_decision "skip-unsafe" "" "" "" "$message"
    return 0
  fi
  if [[ -n "$source" && "$source" != "none" && "$root" == "/" ]]; then
    emit_nested_decision "mount" "$options" "" "" ""
    return 0
  fi
  message="Nested ${fstype:-unknown} mount at '${mountpoint}' has no reliable remount command. The folder was left unchanged."
  emit_nested_decision "skip-unsafe" "" "" "" "$message"
}

read_plan_sorted() {
  local name="$1" direction="$2" file line rel
  file="$(nested_plan_file "$name")"
  [[ -r "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    rel="${line%%"$NESTED_SEP"*}"
    printf '%08d%s%s\n' "${#rel}" "$NESTED_SEP" "$line"
  done < "$file" | if [[ "$direction" == "deep" ]]; then
    sort -r
  else
    sort
  fi | while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    printf '%s\n' "${line#*"$NESTED_SEP"}"
  done
}

classify_folder_nested_mounts() {
  local dir="$1" name="$2"
  local records canon record mountpoint nested="" staging plan_file
  local fstype source vfs fsopts root major mode message options bind_source argv_name
  local rel argv_file index=0 skip_reason=""
  NESTED_DECISION="migrate"
  NESTED_DECISION_MESSAGE=""
  [[ "$name" =~ ^[A-Za-z0-9._:+\-]+$ ]] || {
    NESTED_DECISION="skip"
    NESTED_DECISION_MESSAGE="Skipped because the folder name is not safe to track for nested mounts."
    return 0
  }
  if ! records="$(list_mountinfo_records)"; then
    NESTED_DECISION="skip"
    NESTED_DECISION_MESSAGE="Skipped '${name}' because mounts under '${dir}' could not be read from mountinfo or findmnt."
    return 0
  fi
  canon="$(canonical_mount_path "$dir")"
  [[ -n "$canon" && "$canon" != "/" ]] || {
    NESTED_DECISION="skip"
    NESTED_DECISION_MESSAGE="Skipped '${name}' because its path could not be resolved."
    return 0
  }
  while IFS= read -r record || [[ -n "$record" ]]; do
    [[ -n "$record" ]] || continue
    mountpoint="$(canonical_mount_path "${record%%"$NESTED_SEP"*}")"
    if path_is_strict_child "$canon" "$mountpoint"; then
      nested+="$(nested_record "$mountpoint" "${record#*"$NESTED_SEP"}")"
    fi
  done <<< "$records"
  if [[ -z "$nested" ]]; then
    if [[ -s "$(nested_plan_file "$name")" ]]; then
      log "No nested mount is currently present under '${dir}'. A saved remount plan for '${name}' will be used after the copy."
    fi
    return 0
  fi
  staging="$(mktemp -d 2>/dev/null || true)"
  if [[ -z "$staging" || ! -d "$staging" ]]; then
    NESTED_DECISION="skip"
    NESTED_DECISION_MESSAGE="Skipped '${name}' because a temporary directory for the nested-mount plan could not be created."
    return 0
  fi
  while IFS= read -r record || [[ -n "$record" ]]; do
    [[ -n "$record" ]] || continue
    IFS="$NESTED_SEP" read -r mountpoint fstype source vfs fsopts root major <<< "$record"
    rel="${mountpoint#"$canon"/}"
    [[ -n "$rel" && "$rel" != /* && "$rel" != *".."* ]] || {
      skip_reason="Skipped '${name}' because nested mount '${mountpoint}' is not a safe path under the folder."
      break
    }
    argv_file="${staging}/argv-${index}"
    IFS="$NESTED_SEP" read -r mode options bind_source argv_name message <<< "$(plan_one_nested_mount "$mountpoint" "$fstype" "$source" "$vfs" "$fsopts" "$root" "$major" "$argv_file")"
    if [[ "$mode" == skip-* ]]; then
      skip_reason="${message:-Skipped '${name}' because a nested mount cannot be migrated safely. The folder was left unchanged.}"
      break
    fi
    if [[ "$mode" != "command" ]]; then
      argv_name=""
      rm -f -- "$argv_file"
    fi
    nested_record \
      "$(sanitize_tsv "$rel")" \
      "$(sanitize_tsv "$fstype")" \
      "$(sanitize_tsv "$source")" \
      "$(sanitize_tsv "$options")" \
      "$(sanitize_tsv "$mode")" \
      "$(sanitize_tsv "$bind_source")" \
      "$(sanitize_tsv "$argv_name")" >> "${staging}/mounts.tsv"
    log "Nested ${fstype} mount under '${name}' at '${rel}' will be unmounted, local files copied, and the mount restored (${mode})."
    index=$((index + 1))
  done <<< "$nested"
  if [[ -n "$skip_reason" ]]; then
    rm -rf -- "$staging"
    clear_nested_plan "$name"
    NESTED_DECISION="skip"
    NESTED_DECISION_MESSAGE="$skip_reason"
    return 0
  fi
  clear_nested_plan "$name"
  ensure_dir "$(nested_plan_dir "$name")"
  plan_file="$(nested_plan_file "$name")"
  mv -- "${staging}/mounts.tsv" "$plan_file"
  if compgen -G "${staging}/argv-*" >/dev/null; then
    mv -- "${staging}"/argv-* "$(nested_plan_dir "$name")/"
  fi
  rmdir -- "$staging" 2>/dev/null || rm -rf -- "$staging"
  chmod 0640 "$plan_file" >/dev/null 2>&1 || true
  apply_owner "$plan_file"
  NESTED_DECISION="migrate"
  NESTED_DECISION_MESSAGE=""
}

ensure_mountpoint_dir() {
  local dest="$1" source="${2:-}"
  mkdir -p -- "$dest"
  if [[ -n "$source" && -d "$source" ]]; then
    chown --reference="$source" "$dest" >/dev/null 2>&1 || true
    chmod --reference="$source" "$dest" >/dev/null 2>&1 || true
    touch --reference="$source" "$dest" >/dev/null 2>&1 || true
  fi
}

ensure_planned_mountpoint_dirs() {
  local name="$1" dest_root="$2" source_root="${3:-}"
  local line rel target source_dir
  [[ -n "$name" && -n "$dest_root" && -s "$(nested_plan_file "$name")" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    IFS="$NESTED_SEP" read -r rel _ <<< "$line"
    [[ -n "$rel" && "$rel" != /* && "$rel" != *".."* ]] || continue
    target="${dest_root%/}/${rel}"
    source_dir=""
    if [[ -n "$source_root" ]]; then
      source_dir="${source_root%/}/${rel}"
    fi
    ensure_mountpoint_dir "$target" "$source_dir"
    log "Recreated nested mountpoint directory '${target}'."
  done < <(read_plan_sorted "$name" shallow)
}

remount_one() {
  local mode="$1" source="$2" fstype="$3" options="$4" target="$5" bind_source="$6" argv_file="$7"
  local -a argv=()
  local arg
  ensure_mountpoint_dir "$target"
  case "$mode" in
    command)
      [[ -r "$argv_file" ]] || return 1
      while IFS= read -r -d '' arg || [[ -n "$arg" ]]; do
        [[ -n "$arg" ]] || continue
        argv+=("$arg")
      done < "$argv_file"
      (( ${#argv[@]} > 0 )) || return 1
      "${argv[@]}"
      ;;
    bind)
      [[ -n "$bind_source" && -e "$bind_source" ]] || return 1
      mount --bind -- "$bind_source" "$target"
      ;;
    mount)
      if [[ -n "$options" ]]; then
        mount -t "$fstype" -o "$options" -- "$source" "$target"
      else
        mount -t "$fstype" -- "$source" "$target"
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

restore_planned_mounts() {
  local name="$1" dest_root="$2" source_root="${3:-}"
  local line rel fstype source options mode bind_source argv_name
  local target source_dir argv_file attempt ok failed=0
  [[ -n "$name" && -n "$dest_root" ]] || return 0
  [[ -s "$(nested_plan_file "$name")" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    IFS="$NESTED_SEP" read -r rel fstype source options mode bind_source argv_name <<< "$line"
    [[ -n "$rel" && "$rel" != /* && "$rel" != *".."* ]] || {
      failed=1
      continue
    }
    target="${dest_root%/}/${rel}"
    source_dir=""
    if [[ -n "$source_root" ]]; then
      source_dir="${source_root%/}/${rel}"
    fi
    if path_is_mounted "$target"; then
      log "Nested mount already present at '${target}'."
      continue
    fi
    ensure_mountpoint_dir "$target" "$source_dir"
    argv_file=""
    if [[ -n "$argv_name" ]]; then
      argv_file="$(nested_plan_dir "$name")/${argv_name}"
    fi
    ok=0
    for attempt in 1 2 3; do
      if remount_one "$mode" "$source" "$fstype" "$options" "$target" "$bind_source" "$argv_file"; then
        if path_is_mounted "$target"; then
          ok=1
          break
        fi
        log "Remount command for '${target}' finished, but the mount is not visible in mountinfo."
      else
        log "Remount attempt ${attempt} failed for '${target}'."
      fi
      sleep "$(nested_retry_delay)"
    done
    if (( ok == 0 )); then
      log "Could not remount nested ${fstype:-mount} at '${target}'."
      failed=1
    else
      log "Remounted nested ${fstype:-mount} at '${target}'."
    fi
  done < <(read_plan_sorted "$name" shallow)
  (( failed == 0 ))
}

safely_unmount_path() {
  local target="$1" attempt
  if ! path_is_mounted "$target"; then
    return 0
  fi
  for attempt in 1 2 3; do
    umount -- "$target" >/dev/null 2>&1 || true
    if ! path_is_mounted "$target"; then
      log "Unmounted nested mount '${target}'."
      return 0
    fi
    sleep "$(nested_retry_delay)"
  done
  log "Nested mount '${target}' is still busy. It was not force-unmounted."
  return 1
}

unmount_planned_mounts() {
  local name="$1" root="$2"
  local line rel target failed_target=""
  local -a lines=()
  mapfile -t lines < <(read_plan_sorted "$name" deep)
  (( ${#lines[@]} > 0 )) || return 0
  for line in "${lines[@]}"; do
    [[ -n "$line" ]] || continue
    IFS="$NESTED_SEP" read -r rel _ <<< "$line"
    target="${root%/}/${rel}"
    if ! safely_unmount_path "$target"; then
      failed_target="$target"
      break
    fi
  done
  if [[ -n "$failed_target" ]]; then
    restore_planned_mounts "$name" "$root" "$root" || log "Could not put nested mounts back under '${root}' after an unmount failure."
    NESTED_UNMOUNTED_FOLDER=""
    NESTED_DECISION_MESSAGE="Skipped '${name}' because nested mount '${failed_target}' could not be safely unmounted. The folder was left unchanged."
    return 1
  fi
  NESTED_UNMOUNTED_FOLDER="$name"
  return 0
}

prepare_nested_mounts_before_cutover() {
  local folder_index="$1"
  local name="${FOLDER_NAMES[$folder_index]}"
  local dir="${FOLDER_SOURCE_PATHS[$folder_index]}"
  classify_folder_nested_mounts "$dir" "$name"
  if [[ "$NESTED_DECISION" == "skip" ]]; then
    log "Skipping '${name}' before cutover: ${NESTED_DECISION_MESSAGE}"
    mark_folder_terminal "$folder_index" "skipped" "$NESTED_DECISION_MESSAGE"
    return 1
  fi
  if ! unmount_planned_mounts "$name" "$dir"; then
    mark_folder_terminal "$folder_index" "skipped" "${NESTED_DECISION_MESSAGE:-Skipped '${name}' because a nested mount could not be safely unmounted. The folder was left unchanged.}"
    return 1
  fi
  return 0
}

abort_folder_migration() {
  local folder_index="$1"
  local entry_path="$2"
  local temp_path="${3:-}"
  local dataset="${4:-}"
  local state="${5:-failed}"
  local message="${6:-}"
  local name="" restore_root
  if [[ "$folder_index" =~ ^[0-9]+$ ]]; then
    name="${FOLDER_NAMES[$folder_index]:-}"
  fi
  if [[ -n "$message" ]]; then
    note_folder_error "$message"
  fi
  if [[ -n "$temp_path" || -n "$dataset" ]]; then
    rollback_failed_folder "$entry_path" "$temp_path" "$dataset"
  fi
  if [[ -n "${NESTED_UNMOUNTED_FOLDER:-}" && -n "$name" ]]; then
    restore_root="$entry_path"
    if [[ ! -d "$entry_path" && -n "$temp_path" && -d "$temp_path" ]]; then
      restore_root="$temp_path"
    fi
    restore_planned_mounts "$name" "$restore_root" "$temp_path" || log "Could not put every nested mount back under '${restore_root}'."
    NESTED_UNMOUNTED_FOLDER=""
  fi
  if [[ -n "$message" ]]; then
    mark_folder_terminal "$folder_index" "$state" "$message"
  fi
  return 0
}

restart_policy_pending_file() {
  printf '%s' "${ZFSAS_MIGRATOR_RESTART_POLICY_PENDING_FILE:-${PLUGIN_ROOT}/restart-policies-pending.tsv}"
}

handle_folder_problem() {
  local folder_index="$1"
  local fallback_state="${2:-failed}"
  local fallback_message="${3:-}"
  local state
  if [[ ! "$folder_index" =~ ^[0-9]+$ ]]; then
    clear_handled_error
    return 0
  fi
  state="${FOLDER_STATES[$folder_index]:-}"
  case "$state" in
    complete|failed|reverted|skipped) ;;
    *)
      fallback_message="${fallback_message:-${LAST_ERROR:-This folder could not be migrated. It was left unchanged.}}"
      mark_folder_terminal "$folder_index" "$fallback_state" "$fallback_message"
      ;;
  esac
  clear_handled_error
  if [[ -n "${CURRENT_BATCH_CONTAINERS:-}" ]]; then
    set_status "restarting_containers" "restarting_containers" "Restoring containers after ${FOLDER_NAMES[$folder_index]:-a folder} was skipped or failed."
    start_selected_containers "$CURRENT_BATCH_CONTAINERS" || true
    CURRENT_BATCH_CONTAINERS=""
    CURRENT_BATCH_FOLDERS=""
  fi
}

restore_restart_policies_left_disabled() {
  local id cname policy max was_running policy_disabled start_state last_error
  local spec attempt restored should_start any_disabled=0
  local pending containers_tmp pending_tmp batch_filter="" row_index=0 in_batch
  local -A seen_ids=()
  pending="$(restart_policy_pending_file)"
  [[ -r "$CONTAINERS_FILE" || -s "$pending" ]] || return 0
  if [[ -r "$RECOVERY_STATE_FILE" ]]; then
    batch_filter="$(
      # shellcheck disable=SC1090
      source "$RECOVERY_STATE_FILE"
      normalize_word_list "${RECOVERY_BATCH_CONTAINERS:-}"
    )"
  fi
  containers_tmp="$(mktemp)"
  pending_tmp="$(mktemp)"
  restore_saved_container_row() {
    local row_id="$1" row_name="$2" row_policy="$3" row_max="$4" row_running="$5" row_disabled="$6"
    [[ -n "$row_id" ]] || return 0
    [[ -z "${seen_ids[$row_id]:-}" ]] || return 0
    seen_ids["$row_id"]=1
    should_start=0
    if [[ "$row_disabled" == "1" && "$row_running" == "1" ]]; then
      should_start=1
    fi
    if [[ "$row_disabled" == "1" && -n "$row_policy" && "$row_policy" != "no" ]]; then
      any_disabled=1
      spec="$(restart_policy_spec "$row_policy" "${row_max:-0}")"
      log "Restoring restart policy for ${row_name:-$row_id} to ${spec}. A previous migration stopped before putting it back."
      restored=0
      for attempt in 1 2 3; do
        if docker update --restart="$spec" "$row_id" >/dev/null 2>&1; then
          restored=1
          row_disabled="0"
          break
        fi
        sleep "$(nested_retry_delay)"
      done
      if (( restored == 0 )); then
        log "Unable to restore restart policy ${spec} for ${row_name:-$row_id}."
      fi
    fi
    if (( should_start == 1 )) && ! container_is_running_by_id "$row_id"; then
      log "Starting ${row_name:-$row_id} because a previous migration left it stopped."
      if ! docker start "$row_id" >/dev/null 2>&1; then
        sleep "${RESTART_RETRY_DELAY}"
        docker start "$row_id" >/dev/null 2>&1 || log "Unable to start ${row_name:-$row_id} after restoring its restart policy."
      fi
    fi
    if [[ "$row_disabled" == "1" ]]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(sanitize_tsv "$row_id")" \
        "$(sanitize_tsv "$row_name")" \
        "$(sanitize_tsv "$row_policy")" \
        "$(sanitize_tsv "$row_max")" \
        "$(sanitize_tsv "$row_running")" \
        "1" \
        "$(sanitize_tsv "$start_state")" \
        "$(sanitize_tsv "$last_error")" >> "$pending_tmp"
    fi
    policy_disabled="$row_disabled"
  }
  if [[ -r "$CONTAINERS_FILE" ]]; then
    while IFS=$'\t' read -r id cname policy max was_running policy_disabled start_state last_error || [[ -n "${id:-}" ]]; do
      [[ -n "${id:-}" ]] || continue
      in_batch=1
      if [[ -n "$batch_filter" ]] && ! list_has_word "$batch_filter" "$row_index"; then
        in_batch=0
      fi
      if (( in_batch == 1 )); then
        restore_saved_container_row "$id" "$cname" "$policy" "$max" "$was_running" "$policy_disabled"
      else
        seen_ids["$id"]=1
      fi
      row_index=$((row_index + 1))
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(sanitize_tsv "$id")" \
        "$(sanitize_tsv "$cname")" \
        "$(sanitize_tsv "$policy")" \
        "$(sanitize_tsv "$max")" \
        "$(sanitize_tsv "$was_running")" \
        "$(sanitize_tsv "$policy_disabled")" \
        "$(sanitize_tsv "$start_state")" \
        "$(sanitize_tsv "$last_error")" >> "$containers_tmp"
    done < "$CONTAINERS_FILE"
    mv -- "$containers_tmp" "$CONTAINERS_FILE"
    chmod 0640 "$CONTAINERS_FILE" >/dev/null 2>&1 || true
    apply_owner "$CONTAINERS_FILE"
  else
    rm -f -- "$containers_tmp"
  fi
  if [[ -s "$pending" ]]; then
    while IFS=$'\t' read -r id cname policy max was_running policy_disabled start_state last_error || [[ -n "${id:-}" ]]; do
      [[ -n "${id:-}" ]] || continue
      restore_saved_container_row "$id" "$cname" "$policy" "$max" "$was_running" "$policy_disabled"
    done < "$pending"
  fi
  if [[ -s "$pending_tmp" ]]; then
    mv -- "$pending_tmp" "$pending"
    chmod 0640 "$pending" >/dev/null 2>&1 || true
    apply_owner "$pending"
  else
    rm -f -- "$pending_tmp" "$pending"
  fi
  if (( any_disabled == 1 )); then
    log "Checked saved containers for restart policies left disabled by an interrupted migration."
  fi
}

assert_path_is_mountpoint_for_dataset() {
  local ds="$1"
  local expected_path="$2"
  local actual_mountpoint mounted
  actual_mountpoint="$(zfs get -H -o value mountpoint "$ds")"
  [[ "$actual_mountpoint" == "$expected_path" ]] || { note_folder_error "Dataset '$ds' mountpoint mismatch. Expected '$expected_path', got '$actual_mountpoint'"; return 1; }
  [[ -d "$expected_path" ]] || { note_folder_error "Mountpoint directory missing for dataset '$ds': $expected_path"; return 1; }
  mounted="$(zfs get -H -o value mounted "$ds")"
  [[ "$mounted" == "yes" ]] || { note_folder_error "Dataset '$ds' has correct mountpoint property but is not currently mounted."; return 1; }
}

verify_destination_is_empty() {
  local path="$1"
  if find "$path" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    note_folder_error "Destination path is not empty: $path"
    return 1
  fi
}

generate_file_manifest() {
  local root="$1"
  (
    cd "$root"
    find . -xdev -type f -print0 | sort -z | while IFS= read -r -d '' f; do
      sha256sum -z -- "$f"
    done
  )
}

generate_symlink_manifest() {
  local root="$1"
  (
    cd "$root"
    find . -xdev -type l -print0 | sort -z | while IFS= read -r -d '' lnk; do
      printf '%s\0%s\0' "$lnk" "$(readlink -- "$lnk")"
    done
  )
}

fail_verify() {
  local message="$1"
  if (( VERIFY_FAILURES_ARE_FATAL == 1 )); then
    die "$message" || return 1
  fi
  log "$message"
  return 1
}

compare_manifests() {
  local src="$1"
  local dst="$2"
  cmp -s <(generate_file_manifest "$src") <(generate_file_manifest "$dst") || fail_verify "Regular file SHA-256 manifest mismatch between '$src' and '$dst'" || return 1
  cmp -s <(generate_symlink_manifest "$src") <(generate_symlink_manifest "$dst") || fail_verify "Symlink manifest mismatch between '$src' and '$dst'" || return 1
}

compare_counts() {
  local src="$1"
  local dst="$2"
  local src_files dst_files src_dirs dst_dirs src_links dst_links
  src_files="$(find "$src" -xdev -type f | wc -l)"
  dst_files="$(find "$dst" -xdev -type f | wc -l)"
  [[ "$src_files" == "$dst_files" ]] || fail_verify "Regular file count mismatch: source=$src_files dest=$dst_files" || return 1
  src_dirs="$(find "$src" -xdev -type d | wc -l)"
  dst_dirs="$(find "$dst" -xdev -type d | wc -l)"
  [[ "$src_dirs" == "$dst_dirs" ]] || fail_verify "Directory count mismatch: source=$src_dirs dest=$dst_dirs" || return 1
  src_links="$(find "$src" -xdev -type l | wc -l)"
  dst_links="$(find "$dst" -xdev -type l | wc -l)"
  [[ "$src_links" == "$dst_links" ]] || fail_verify "Symlink count mismatch: source=$src_links dest=$dst_links" || return 1
}

rsync_copy_with_progress() {
  local src="$1"
  local dst="$2"
  local folder_index="$3"
  local line rsync_status=0 percent=0 last_error=""

  while true; do
    rsync_status=0
    last_error=""
    while IFS= read -r line; do
      if [[ "$line" == __RSYNC_EXIT_STATUS__:* ]]; then
        rsync_status="${line#__RSYNC_EXIT_STATUS__:}"
        continue
      fi

      printf '%s\n' "$line"
      last_error="$line"
      if [[ "$line" =~ ([0-9]{1,3})% ]]; then
        percent="${BASH_REMATCH[1]}"
        if (( percent > 100 )); then
          percent=100
        fi
        folder_set "$folder_index" "copying" "$(( percent * 80 / 100 ))" "Copying data (${percent}%)."
      fi
    done < <(
      rsync -aHAXx --numeric-ids --human-readable --info=progress2 "$src"/ "$dst"/ 2>&1
      printf '__RSYNC_EXIT_STATUS__:%s\n' "$?"
    )

    [[ "$rsync_status" =~ ^[0-9]+$ ]] || rsync_status=1
    if (( rsync_status == 0 )); then
      folder_set "$folder_index" "copy_complete" 80 "Copy finished. Starting verification."
      return 0
    fi

    if (( rsync_status == 11 )) || [[ "$last_error" == *"No space left on device"* ]]; then
      log "Copy hit low space for '${FOLDER_NAMES[$folder_index]}'. Waiting for more free space before retrying."
      wait_for_resume_space "${FOLDER_NAMES[$folder_index]}" "$folder_index"
      folder_set "$folder_index" "copying" "${FOLDER_PROGRESS[$folder_index]:-0}" "Free space recovered. Retrying copy."
      continue
    fi

    note_folder_error "Rsync copy failed for '${FOLDER_NAMES[$folder_index]}' with exit status $rsync_status. ${last_error}"
    return 1
  done
}

rsync_verify() {
  local src="$1"
  local dst="$2"
  local line had_differences=0 rsync_status=
  while IFS= read -r line; do
    if [[ "$line" == __RSYNC_EXIT_STATUS__:* ]]; then
      rsync_status="${line#__RSYNC_EXIT_STATUS__:}"
      continue
    fi
    if (( had_differences == 0 )); then
      log "Rsync verification reported differences:"
      had_differences=1
    fi
    printf '%s\n' "$line"
  done < <(
    rsync -aHAXcnx --delete --numeric-ids --itemize-changes "$src"/ "$dst"/ 2>&1
    printf '__RSYNC_EXIT_STATUS__:%s\n' "$?"
  )
  [[ "$rsync_status" =~ ^[0-9]+$ ]] || fail_verify "Unable to determine rsync verification exit status" || return 1
  (( rsync_status == 0 )) || fail_verify "Rsync checksum verification failed with exit status $rsync_status" || return 1
  if (( had_differences == 1 )); then
    fail_verify "Rsync checksum verification reported differences between '$src' and '$dst'" || return 1
  fi
}

docker_daemon_is_running() {
  docker info >/dev/null 2>&1
}

container_inspect_line() {
  local container_id="$1"
  docker inspect -f '{{.Id}}|{{.Name}}|{{.HostConfig.RestartPolicy.Name}}|{{.HostConfig.RestartPolicy.MaximumRetryCount}}|{{.HostConfig.NetworkMode}}|{{range $i, $v := .HostConfig.VolumesFrom}}{{if $i}},{{end}}{{$v}}{{end}}|{{index .Config.Labels "com.docker.compose.depends_on"}}' "$container_id" 2>/dev/null || true
}

container_mount_sources() {
  local container_id="$1"
  docker inspect -f '{{range .Mounts}}{{println .Source}}{{end}}' "$container_id" 2>/dev/null || true
}

container_is_running_by_id() {
  local container_id="$1"
  [[ "$(docker inspect -f '{{.State.Running}}' "$container_id" 2>/dev/null || printf 'false')" == "true" ]]
}

normalize_container_ref() {
  local ref
  ref="$(trim "$1")"
  ref="${ref#/}"
  if [[ "$ref" == "<no value>" || "$ref" == "null" ]]; then
    printf ''
    return 0
  fi
  ref="${ref%%:*}"
  printf '%s' "$ref"
}

canonicalize_host_path() {
  local path="$1"
  path="$(trim "$path")"
  [[ -n "$path" ]] || {
    printf ''
    return 0
  }
  readlink -f -- "$path" 2>/dev/null || printf '%s' "$path"
}

mnt_root() {
  printf '%s' "${ZFSAS_MIGRATOR_MNT_ROOT:-/mnt}"
}

normalize_abs_path() {
  local path="$1"
  path="$(trim "$path")"
  path="${path//\/\//\/}"
  while [[ "$path" == */ && "$path" != "/" ]]; do
    path="${path%/}"
  done
  printf '%s' "$path"
}

storage_root_names() {
  local root key entry base names="" nullglob_was=0
  local -a entries=()
  root="$(mnt_root)"
  key="$root"
  if [[ "$STORAGE_ROOTS_CACHE_KEY" == "$key" ]]; then
    if [[ -n "$STORAGE_ROOTS_CACHE" ]]; then
      printf '%s\n' "$STORAGE_ROOTS_CACHE"
    fi
    return 0
  fi
  if [[ -d "$root" ]]; then
    shopt -q nullglob && nullglob_was=1
    shopt -s nullglob
    entries=("$root"/*)
    if (( nullglob_was == 0 )); then
      shopt -u nullglob
    fi
    for entry in "${entries[@]}"; do
      [[ -d "$entry" ]] || continue
      base="$(basename -- "$entry")"
      case "$base" in
        user|user0|disks|remotes|rootshare|addons|Recycle) continue ;;
      esac
      names+="${names:+$'\n'}$base"
    done
  fi
  STORAGE_ROOTS_CACHE="$names"
  STORAGE_ROOTS_CACHE_KEY="$key"
  if [[ -n "$names" ]]; then
    printf '%s\n' "$names"
  fi
}

emit_share_aliases() {
  local share="$1"
  local rest="$2"
  local storage
  [[ -n "$share" ]] || return 0
  local root
  root="$(mnt_root)"
  if [[ -n "$rest" ]]; then
    printf '%s\n' "$root/user/$share/$rest"
    printf '%s\n' "$root/user0/$share/$rest"
  else
    printf '%s\n' "$root/user/$share"
    printf '%s\n' "$root/user0/$share"
  fi
  while IFS= read -r storage; do
    [[ -n "$storage" ]] || continue
    if [[ -n "$rest" ]]; then
      printf '%s\n' "$root/$storage/$share/$rest"
    else
      printf '%s\n' "$root/$storage/$share"
    fi
  done < <(storage_root_names)
}

equivalent_unraid_paths() {
  local path raw canon root tail share rest storage after
  path="$(normalize_abs_path "$1")"
  [[ -n "$path" ]] || return 0
  raw="$path"
  canon="$(canonicalize_host_path "$raw")"
  canon="$(normalize_abs_path "$canon")"
  printf '%s\n' "$raw"
  if [[ -n "$canon" && "$canon" != "$raw" ]]; then
    printf '%s\n' "$canon"
  fi
  root="$(mnt_root)"
  local candidate
  for candidate in "$raw" "$canon"; do
    [[ -n "$candidate" ]] || continue
    case "$candidate" in
      "$root"/user/*|"$root"/user0/*)
        if [[ "$candidate" == "$root"/user0/* ]]; then
          tail="${candidate#"$root"/user0/}"
        else
          tail="${candidate#"$root"/user/}"
        fi
        share="${tail%%/*}"
        if [[ "$tail" == */* ]]; then
          rest="${tail#*/}"
        else
          rest=""
        fi
        emit_share_aliases "$share" "$rest"
        ;;
      "$root"/*/*)
        after="${candidate#"$root"/}"
        storage="${after%%/*}"
        case "$storage" in
          user|user0|disks|remotes|rootshare|addons) continue ;;
        esac
        tail="${after#*/}"
        share="${tail%%/*}"
        if [[ "$tail" == */* ]]; then
          rest="${tail#*/}"
        else
          rest=""
        fi
        emit_share_aliases "$share" "$rest"
        ;;
    esac
  done
}

path_is_same_or_nested() {
  local left right
  left="$(normalize_abs_path "$1")"
  right="$(normalize_abs_path "$2")"
  [[ -n "$left" && -n "$right" ]] || return 1
  [[ "$left" == "$right" ]] && return 0
  [[ "$left" == "$right"/* ]] && return 0
  [[ "$right" == "$left"/* ]] && return 0
  return 1
}

paths_touch() {
  local left="$1"
  local right="$2"
  local -a left_paths=() right_paths=()
  local a b
  mapfile -t left_paths < <(equivalent_unraid_paths "$left" | awk 'NF && !seen[$0]++')
  mapfile -t right_paths < <(equivalent_unraid_paths "$right" | awk 'NF && !seen[$0]++')
  for a in "${left_paths[@]}"; do
    for b in "${right_paths[@]}"; do
      if path_is_same_or_nested "$a" "$b"; then
        return 0
      fi
    done
  done
  return 1
}

parse_container_dependency_refs() {
  local network_mode="$1"
  local volumes_from="$2"
  local depends_label="$3"
  local refs="" item ref

  if [[ "$network_mode" == container:* ]]; then
    ref="$(normalize_container_ref "${network_mode#container:}")"
    refs="$(list_append_unique "$refs" "$ref")"
  fi

  IFS=',' read -r -a _volumes_from_parts <<< "$volumes_from"
  for item in "${_volumes_from_parts[@]}"; do
    ref="$(normalize_container_ref "$item")"
    refs="$(list_append_unique "$refs" "$ref")"
  done

  depends_label="${depends_label//,/ }"
  depends_label="${depends_label//[/ }"
  depends_label="${depends_label//]/ }"
  depends_label="${depends_label//\"/ }"
  depends_label="${depends_label//;/ }"
  depends_label="${depends_label//=/ }"
  for item in $depends_label; do
    ref="$(normalize_container_ref "$item")"
    refs="$(list_append_unique "$refs" "$ref")"
  done

  printf '%s' "$refs"
}

folder_indexes_for_mount_source() {
  local source="$1"
  local list="" folder_index folder_path

  source="$(trim "$source")"
  [[ -n "$source" ]] || {
    printf ''
    return 0
  }

  for folder_index in "${!FOLDER_SOURCE_PATHS[@]}"; do
    folder_path="${FOLDER_SOURCE_PATHS[$folder_index]}"
    [[ -n "$folder_path" ]] || continue
    if paths_touch "$source" "$folder_path"; then
      list="$(list_append_unique "$list" "$folder_index")"
    fi
  done

  printf '%s' "$list"
}

merge_index_lists() {
  local merged="$1"
  local extra="$2"
  local item
  for item in $extra; do
    merged="$(list_append_unique "$merged" "$item")"
  done
  printf '%s' "$merged"
}

container_folder_indexes_from_mounts() {
  local container_id="$1"
  local source list="" folder_indexes folder_index
  while IFS= read -r source; do
    folder_indexes="$(folder_indexes_for_mount_source "$source")"
    for folder_index in $folder_indexes; do
      list="$(list_append_unique "$list" "$folder_index")"
    done
  done < <(container_mount_sources "$container_id")
  printf '%s' "$list"
}

container_has_pending_folders() {
  local container_index="$1"
  local folder_index
  for folder_index in ${CONTAINER_FOLDER_INDEXES[$container_index]}; do
    if folder_is_pending "$folder_index"; then
      return 0
    fi
  done
  return 1
}

resolve_container_dependencies() {
  local container_index ref dependency_index dependencies
  for container_index in "${!CONTAINER_IDS[@]}"; do
    dependencies=""
    for ref in ${CONTAINER_DEPENDENCY_REFS[$container_index]}; do
      dependency_index=""
      if [[ -n "${CONTAINER_INDEX_BY_ID[$ref]+x}" ]]; then
        dependency_index="${CONTAINER_INDEX_BY_ID[$ref]}"
      elif [[ -n "${CONTAINER_INDEX_BY_NAME[$ref]+x}" ]]; then
        dependency_index="${CONTAINER_INDEX_BY_NAME[$ref]}"
      fi

      if [[ -n "$dependency_index" && "$dependency_index" != "$container_index" ]]; then
        dependencies="$(list_append_unique "$dependencies" "$dependency_index")"
      fi
    done
    CONTAINER_DEPENDENCY_INDEXES[container_index]="$dependencies"
  done
}

container_index_for_ref() {
  local ref="$1"
  ref="$(normalize_container_ref "$ref")"
  [[ -n "$ref" ]] || return 1
  if [[ -n "${CONTAINER_INDEX_BY_ID[$ref]+x}" ]]; then
    printf '%s' "${CONTAINER_INDEX_BY_ID[$ref]}"
    return 0
  fi
  if [[ -n "${CONTAINER_INDEX_BY_NAME[$ref]+x}" ]]; then
    printf '%s' "${CONTAINER_INDEX_BY_NAME[$ref]}"
    return 0
  fi
  return 1
}

remember_running_container() {
  local id="$1"
  local name="$2"
  local policy="$3"
  local max_retry="$4"
  local network_mode="$5"
  local volumes_from="$6"
  local depends_label="$7"
  local folder_indexes="$8"
  local reason="${9:-}"
  local container_index folder_index refs before merged created=0
  name="${name#/}"
  if [[ -n "${CONTAINER_INDEX_BY_ID[$id]+x}" ]]; then
    container_index="${CONTAINER_INDEX_BY_ID[$id]}"
  elif [[ -n "${CONTAINER_INDEX_BY_NAME[$name]+x}" ]]; then
    container_index="${CONTAINER_INDEX_BY_NAME[$name]}"
  else
    created=1
    refs="$(parse_container_dependency_refs "$network_mode" "$volumes_from" "$depends_label")"
    container_index="${#CONTAINER_IDS[@]}"
    CONTAINER_IDS+=("$id")
    CONTAINER_NAMES+=("$name")
    CONTAINER_RESTART_NAMES+=("${policy:-no}")
    CONTAINER_RESTART_MAXS+=("${max_retry:-0}")
    CONTAINER_NETWORK_MODES+=("${network_mode:-default}")
    CONTAINER_FOLDER_INDEXES+=("")
    CONTAINER_DEPENDENCY_REFS+=("$refs")
    CONTAINER_DEPENDENCY_INDEXES+=("")
    CONTAINER_WAS_RUNNING+=("1")
    CONTAINER_CURRENTLY_RUNNING+=("1")
    CONTAINER_POLICY_DISABLED+=("0")
    CONTAINER_START_STATES+=("running")
    CONTAINER_LAST_ERRORS+=("")
    CONTAINER_INDEX_BY_NAME["$name"]="$container_index"
    CONTAINER_INDEX_BY_ID["$id"]="$container_index"
    if [[ -n "$reason" ]]; then
      log "Container ${name} will be stopped with the migration batch (${reason})."
    fi
  fi

  before="${CONTAINER_FOLDER_INDEXES[$container_index]}"
  merged="$(merge_index_lists "$before" "$folder_indexes")"
  CONTAINER_FOLDER_INDEXES[container_index]="$merged"
  for folder_index in $folder_indexes; do
    FOLDER_CONTAINER_INDEXES[folder_index]="$(list_append_unique "${FOLDER_CONTAINER_INDEXES[$folder_index]}" "$container_index")"
  done
  if (( created == 1 )) || [[ "$merged" != "$before" ]]; then
    return 0
  fi
  return 1
}

close_running_container_dependencies() {
  local running_ids=() id inspect name policy max_retry network_mode volumes_from depends_label refs
  local changed=1 ref related_index related_folders container_index container_refs
  mapfile -t running_ids < <(docker ps -q 2>/dev/null || true)
  while (( changed == 1 )); do
    changed=0
    for id in "${running_ids[@]}"; do
      [[ -n "$id" ]] || continue
      inspect="$(container_inspect_line "$id")"
      [[ -n "$inspect" ]] || continue
      IFS='|' read -r id name policy max_retry network_mode volumes_from depends_label <<< "$inspect"
      name="${name#/}"
      refs="$(parse_container_dependency_refs "$network_mode" "$volumes_from" "$depends_label")"
      related_folders=""
      for ref in $refs; do
        related_index="$(container_index_for_ref "$ref" || true)"
        [[ -n "$related_index" ]] || continue
        related_folders="$(merge_index_lists "$related_folders" "${CONTAINER_FOLDER_INDEXES[$related_index]}")"
      done
      for container_index in "${!CONTAINER_IDS[@]}"; do
        container_refs="${CONTAINER_DEPENDENCY_REFS[$container_index]}"
        for ref in $container_refs; do
          if [[ "$ref" == "$name" || "$ref" == "$id" ]]; then
            related_folders="$(merge_index_lists "$related_folders" "${CONTAINER_FOLDER_INDEXES[$container_index]}")"
          fi
        done
      done
      [[ -n "$related_folders" ]] || continue
      if remember_running_container "$id" "$name" "$policy" "$max_retry" "$network_mode" "$volumes_from" "$depends_label" "$related_folders" "it depends on a container whose mount overlaps a folder being migrated, or that container depends on it via network container:, volumes_from, or compose depends_on"; then
        changed=1
      fi
    done
  done
  resolve_container_dependencies
}

record_running_containers() {
  local running_ids=() id inspect name policy max_retry network_mode volumes_from depends_label folder_indexes
  mapfile -t running_ids < <(docker ps -q 2>/dev/null || true)
  for id in "${running_ids[@]}"; do
    [[ -n "$id" ]] || continue
    inspect="$(container_inspect_line "$id")"
    [[ -n "$inspect" ]] || continue
    IFS='|' read -r id name policy max_retry network_mode volumes_from depends_label <<< "$inspect"
    folder_indexes="$(container_folder_indexes_from_mounts "$id")"
    [[ -n "$folder_indexes" ]] || continue
    remember_running_container "$id" "${name#/}" "$policy" "$max_retry" "$network_mode" "$volumes_from" "$depends_label" "$folder_indexes" "a mount overlaps a folder being migrated" || true
  done
  close_running_container_dependencies
  write_status_file
}

container_related_pending_indexes() {
  local container_index="$1"
  local related="" dependency_index other_index

  for dependency_index in ${CONTAINER_DEPENDENCY_INDEXES[$container_index]}; do
    if container_has_pending_folders "$dependency_index"; then
      related="$(list_append_unique "$related" "$dependency_index")"
    fi
  done

  for other_index in "${!CONTAINER_IDS[@]}"; do
    for dependency_index in ${CONTAINER_DEPENDENCY_INDEXES[$other_index]}; do
      if [[ "$dependency_index" == "$container_index" ]] && container_has_pending_folders "$other_index"; then
        related="$(list_append_unique "$related" "$other_index")"
      fi
    done
  done

  printf '%s' "$related"
}

select_batch_for_folder() {
  local start_folder_index="$1"
  local batch_folders="$start_folder_index"
  local batch_containers=""
  local changed=1
  local folder_index container_index related_index related_containers

  while (( changed == 1 )); do
    changed=0

    for folder_index in $batch_folders; do
      for container_index in ${FOLDER_CONTAINER_INDEXES[$folder_index]}; do
        if container_has_pending_folders "$container_index" && ! list_has_word "$batch_containers" "$container_index"; then
          batch_containers="$(list_append_unique "$batch_containers" "$container_index")"
          changed=1
        fi
      done
    done

    for container_index in $batch_containers; do
      for folder_index in ${CONTAINER_FOLDER_INDEXES[$container_index]}; do
        if folder_is_pending "$folder_index" && ! list_has_word "$batch_folders" "$folder_index"; then
          batch_folders="$(list_append_unique "$batch_folders" "$folder_index")"
          changed=1
        fi
      done

      related_containers="$(container_related_pending_indexes "$container_index")"
      for related_index in $related_containers; do
        if ! list_has_word "$batch_containers" "$related_index"; then
          batch_containers="$(list_append_unique "$batch_containers" "$related_index")"
          changed=1
        fi
      done
    done
  done

  CURRENT_BATCH_FOLDERS="$batch_folders"
  CURRENT_BATCH_CONTAINERS="$batch_containers"
}

restart_policy_spec() {
  local name="$1"
  local max_retry="$2"
  if [[ "$name" == "on-failure" && "$max_retry" =~ ^[0-9]+$ ]] && (( max_retry > 0 )); then
    printf '%s:%s' "$name" "$max_retry"
    return 0
  fi
  printf '%s' "$name"
}

folder_is_pending() {
  local folder_index="$1"
  case "${FOLDER_STATES[$folder_index]:-}" in
    complete|failed|reverted|skipped) return 1 ;;
  esac
  return 0
}

next_pending_folder_index() {
  local folder_index
  for folder_index in "${!FOLDER_NAMES[@]}"; do
    if folder_is_pending "$folder_index"; then
      printf '%s' "$folder_index"
      return 0
    fi
  done
  return 1
}

build_container_start_order() {
  local remaining="$1"
  local order="" progress container_index dependency_index unresolved snapshot

  while [[ -n "$remaining" ]]; do
    progress=0
    snapshot="$remaining"
    for container_index in $snapshot; do
      unresolved=0
      for dependency_index in ${CONTAINER_DEPENDENCY_INDEXES[$container_index]}; do
        if list_has_word "$remaining" "$dependency_index"; then
          unresolved=1
          break
        fi
      done
      if (( unresolved == 0 )); then
        order="$(list_append_unique "$order" "$container_index")"
        remaining="$(list_remove_word "$remaining" "$container_index")"
        progress=1
      fi
    done

    if (( progress == 0 )); then
      for container_index in $remaining; do
        order="$(list_append_unique "$order" "$container_index")"
      done
      break
    fi
  done

  printf '%s' "$order"
}

reverse_index_list() {
  local input="$1"
  local -a indexes=()
  local i output=""
  mapfile -t indexes <<< "$input"
  for (( i=${#indexes[@]} - 1; i>=0; i-- )); do
    output="$(list_append_unique "$output" "${indexes[$i]}")"
  done
  printf '%s' "$output"
}

build_folder_batch_order() {
  local batch_folders="$1"
  local batch_containers="$2"
  local folder_order="" container_order container_index folder_index

  container_order="$(build_container_start_order "$batch_containers")"
  for container_index in $container_order; do
    for folder_index in ${CONTAINER_FOLDER_INDEXES[$container_index]}; do
      if list_has_word "$batch_folders" "$folder_index" && folder_is_pending "$folder_index"; then
        folder_order="$(list_append_unique "$folder_order" "$folder_index")"
      fi
    done
  done

  for folder_index in $batch_folders; do
    if folder_is_pending "$folder_index"; then
      folder_order="$(list_append_unique "$folder_order" "$folder_index")"
    fi
  done

  printf '%s' "$folder_order"
}

temporarily_disable_restart_policies() {
  local target_indexes="$1"
  local index spec
  for index in $target_indexes; do
    if [[ "${CONTAINER_RESTART_NAMES[$index]}" == "no" || "${CONTAINER_POLICY_DISABLED[$index]}" == "1" ]]; then
      continue
    fi
    spec="$(restart_policy_spec "${CONTAINER_RESTART_NAMES[$index]}" "${CONTAINER_RESTART_MAXS[$index]}")"
    log "Temporarily disabling restart policy for ${CONTAINER_NAMES[$index]} (was ${spec})"
    if docker update --restart=no "${CONTAINER_IDS[$index]}" >/dev/null 2>&1; then
      CONTAINER_POLICY_DISABLED[index]="1"
      CONTAINER_START_STATES[index]="restart_policy_disabled"
    else
      CONTAINER_LAST_ERRORS[index]="Unable to disable restart policy before stop."
    fi
  done
  write_status_file
}

stop_container_batch() {
  local target_indexes="$1"
  local start_order stop_order index
  if ! docker_daemon_is_running; then
    log "Docker daemon is not running. No containers need to be stopped."
    return 0
  fi

  if [[ -z "$target_indexes" ]]; then
    return 0
  fi

  temporarily_disable_restart_policies "$target_indexes"
  set_status "stopping_containers" "stopping_containers" "Stopping only the containers used by the current migration batch."
  NEEDS_CONTAINER_RECOVERY=1

  start_order="$(build_container_start_order "$target_indexes")"
  stop_order="$(reverse_index_list "$start_order")"

  for index in $stop_order; do
    if [[ "${CONTAINER_CURRENTLY_RUNNING[$index]}" != "1" ]]; then
      continue
    fi

    log "Stopping container ${CONTAINER_NAMES[$index]}"
    docker stop "${CONTAINER_IDS[$index]}" >/dev/null 2>&1 || true

    while container_is_running_by_id "${CONTAINER_IDS[$index]}"; do
      MESSAGE="Waiting for ${CONTAINER_NAMES[$index]} to stop."
      write_status_file
      sleep 2
    done

    CONTAINER_CURRENTLY_RUNNING[index]="0"
    CONTAINER_START_STATES[index]="stopped"
    CONTAINER_LAST_ERRORS[index]=""
    write_status_file
  done

  ensure_batch_containers_stopped "$target_indexes"
}

ensure_batch_containers_stopped() {
  local target_indexes="$1"
  local index names=""
  if ! docker_daemon_is_running; then
    return 0
  fi

  for index in $target_indexes; do
    if container_is_running_by_id "${CONTAINER_IDS[$index]}"; then
      names+="${CONTAINER_NAMES[$index]}, "
    fi
  done

  [[ -z "$names" ]] && return 0
  note_folder_error "A Docker container restarted during migration (${names%, }). Stop watchdogs and automatic relaunch tools before trying again."
  return 1
}

restore_restart_policies() {
  local target_indexes="${1:-}"
  local index spec
  if [[ -z "$target_indexes" ]]; then
    target_indexes="$(printf '%s\n' "${!CONTAINER_IDS[@]}")"
  fi
  for index in $target_indexes; do
    if [[ "${CONTAINER_POLICY_DISABLED[$index]}" != "1" ]]; then
      continue
    fi
    spec="$(restart_policy_spec "${CONTAINER_RESTART_NAMES[$index]}" "${CONTAINER_RESTART_MAXS[$index]}")"
    if docker update --restart="$spec" "${CONTAINER_IDS[$index]}" >/dev/null 2>&1; then
      CONTAINER_POLICY_DISABLED[index]="0"
    else
      CONTAINER_LAST_ERRORS[index]="Unable to restore restart policy ${spec}."
    fi
  done
  write_status_file
}

start_selected_containers() {
  local target_indexes="${1:-}"
  local retry_indexes=() index start_order
  if [[ -z "$target_indexes" ]]; then
    target_indexes=""
    for index in "${!CONTAINER_IDS[@]}"; do
      if [[ "${CONTAINER_WAS_RUNNING[$index]}" == "1" && "${CONTAINER_CURRENTLY_RUNNING[$index]}" != "1" ]]; then
        target_indexes="$(list_append_unique "$target_indexes" "$index")"
      fi
    done
  fi
  if [[ -z "$target_indexes" ]]; then
    restore_restart_policies "$target_indexes"
    return 0
  fi

  set_status "restarting_containers" "restarting_containers" "Starting containers for the current migration batch."
  start_order="$(build_container_start_order "$target_indexes")"

  for index in $start_order; do
    if [[ "${CONTAINER_WAS_RUNNING[$index]}" != "1" || "${CONTAINER_CURRENTLY_RUNNING[$index]}" == "1" ]]; then
      continue
    fi
    if docker start "${CONTAINER_IDS[$index]}" >/dev/null 2>&1; then
      CONTAINER_CURRENTLY_RUNNING[index]="1"
      CONTAINER_START_STATES[index]="started"
      CONTAINER_LAST_ERRORS[index]=""
    else
      CONTAINER_START_STATES[index]="retry_pending"
      CONTAINER_LAST_ERRORS[index]="First container start attempt failed."
      retry_indexes+=("$index")
    fi
    write_status_file
  done

  if (( ${#retry_indexes[@]} > 0 )); then
    set_status "retrying_container_start" "retrying_container_start" "Some containers failed to start. Waiting 5 minutes before retrying those containers once."
    sleep "$RESTART_RETRY_DELAY"
    for index in "${retry_indexes[@]}"; do
      if docker start "${CONTAINER_IDS[$index]}" >/dev/null 2>&1; then
        CONTAINER_CURRENTLY_RUNNING[index]="1"
        CONTAINER_START_STATES[index]="started_on_retry"
        CONTAINER_LAST_ERRORS[index]=""
      else
        CONTAINER_START_STATES[index]="retry_failed"
        CONTAINER_LAST_ERRORS[index]="Container still failed after the delayed retry."
      fi
      write_status_file
    done
  fi

  restore_restart_policies "$target_indexes"
  NEEDS_CONTAINER_RECOVERY=0
  for index in "${!CONTAINER_IDS[@]}"; do
    if [[ "${CONTAINER_WAS_RUNNING[$index]}" == "1" && "${CONTAINER_CURRENTLY_RUNNING[$index]}" != "1" ]]; then
      NEEDS_CONTAINER_RECOVERY=1
      break
    fi
  done
}

rollback_failed_folder() {
  local original_path="$1"
  local temp_path="$2"
  local target_dataset="$3"
  # Docker can report a ZFS dataset as busy even after its containers stop.
  # Destroying here fails and leaves both copies. The dataset is removed only
  # in the last-resort path, after Docker, libvirt, and LXC have been stopped.
  log "Leaving dataset '${target_dataset:-<none>}' in place after failure. The preserved source was not deleted."
  if [[ -n "$temp_path" && -d "$temp_path" && ! -e "$original_path" ]]; then
    log "Restoring original folder name after failure: $original_path"
    mv -- "$temp_path" "$original_path" >/dev/null 2>&1 || log "WARNING: Failed to restore original folder name from '$temp_path' to '$original_path'"
  elif [[ -n "$temp_path" && -d "$temp_path" && -e "$original_path" ]]; then
    log "Original path '$original_path' still exists, so the preserved source stays at '$temp_path'."
  fi
}

clear_handled_error() {
  LAST_ERROR=""
  EXIT_CODE=0
}

repair_attempt_limit() {
  local limit="${ZFSAS_MIGRATOR_VERIFY_REPAIR_ATTEMPTS:-3}"
  if [[ ! "$limit" =~ ^[0-9]+$ ]] || (( limit < 1 )); then
    limit=3
  fi
  printf '%s' "$limit"
}

service_settle_seconds() {
  local limit="${ZFSAS_MIGRATOR_SERVICE_SETTLE_SECONDS:-$RECOVERY_BOOT_DELAY_SECONDS}"
  if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
    limit="$RECOVERY_BOOT_DELAY_SECONDS"
  fi
  printf '%s' "$limit"
}

service_stop_wait_seconds() {
  local limit="${ZFSAS_MIGRATOR_SERVICE_STOP_WAIT_SECONDS:-30}"
  [[ "$limit" =~ ^[0-9]+$ ]] || limit=30
  printf '%s' "$limit"
}

record_handled_folder() {
  local name="$1"
  local state="$2"
  local message="$3"
  local tmp existing=""
  ensure_dir "$(dirname "$REVERTED_FOLDERS_FILE")"
  tmp="${REVERTED_FOLDERS_FILE}.tmp"
  if [[ -f "$REVERTED_FOLDERS_FILE" ]]; then
    existing="$(awk -F '\t' -v name="$name" '$1 != name { print }' "$REVERTED_FOLDERS_FILE" || true)"
  fi
  if [[ -n "$existing" ]]; then
    printf '%s\n' "$existing" > "$tmp"
  else
    : > "$tmp"
  fi
  printf '%s\t%s\t%s\n' "$name" "$state" "$message" >> "$tmp"
  mv -- "$tmp" "$REVERTED_FOLDERS_FILE"
}

handled_folder_record() {
  local name="$1"
  [[ -f "$REVERTED_FOLDERS_FILE" ]] || return 1
  awk -F '\t' -v name="$name" '$1 == name { print $2 "\t" $3; found = 1; exit } END { exit(found ? 0 : 1) }' "$REVERTED_FOLDERS_FILE"
}

mark_folder_terminal() {
  local folder_index="$1"
  local state="$2"
  local message="$3"
  local name="" previous=""
  if [[ "$folder_index" =~ ^[0-9]+$ && -n "${FOLDER_NAMES[$folder_index]:-}" ]]; then
    name="${FOLDER_NAMES[$folder_index]}"
    previous="${FOLDER_STATES[$folder_index]:-}"
    case "$previous" in
      complete|failed|reverted|skipped) ;;
      *) COMPLETED_FOLDERS=$((COMPLETED_FOLDERS + 1)) ;;
    esac
    folder_set "$folder_index" "$state" "${FOLDER_PROGRESS[$folder_index]:-0}" "$message"
  fi
  if [[ -z "$name" ]]; then
    name="${RECOVERY_ORIGINAL_NAME:-}"
  fi
  if [[ -n "$name" ]]; then
    record_handled_folder "$name" "$state" "$message"
  fi
  clear_handled_error
}

dataset_is_mounted_at() {
  local dataset="$1"
  local path="$2"
  local actual mounted
  [[ -n "$dataset" && -n "$path" ]] || return 1
  actual="$(zfs get -H -o value mountpoint "$dataset" 2>/dev/null | head -n 1 || true)"
  mounted="$(zfs get -H -o value mounted "$dataset" 2>/dev/null | head -n 1 || true)"
  [[ "$actual" == "$path" && "$mounted" == "yes" ]]
}

verify_copied_folder() {
  local temp_path="$1"
  local dest_path="$2"
  local folder_index="$3"
  local previous="$VERIFY_FAILURES_ARE_FATAL"
  VERIFY_FAILURES_ARE_FATAL=0
  folder_set "$folder_index" "verifying" 86 "Running rsync checksum verification."
  if ! rsync_verify "$temp_path" "$dest_path"; then
    VERIFY_FAILURES_ARE_FATAL="$previous"
    return 1
  fi
  folder_set "$folder_index" "verifying" 92 "Comparing file and symlink manifests."
  if ! compare_manifests "$temp_path" "$dest_path"; then
    VERIFY_FAILURES_ARE_FATAL="$previous"
    return 1
  fi
  folder_set "$folder_index" "verifying" 96 "Comparing file, directory, and symlink counts."
  if ! compare_counts "$temp_path" "$dest_path"; then
    VERIFY_FAILURES_ARE_FATAL="$previous"
    return 1
  fi
  VERIFY_FAILURES_ARE_FATAL="$previous"
  return 0
}

cut_over_verified_folder() {
  local folder_index="$1"
  local temp_path="$2"
  local name="${RECOVERY_ORIGINAL_NAME:-folder}"
  local dest="${RECOVERY_SOURCE_PATH:-}"
  local message=""
  if [[ "$folder_index" =~ ^[0-9]+$ && -n "${FOLDER_NAMES[$folder_index]:-}" ]]; then
    name="${FOLDER_NAMES[$folder_index]}"
  fi
  if [[ -z "$dest" && "$folder_index" =~ ^[0-9]+$ ]]; then
    dest="${FOLDER_SOURCE_PATHS[$folder_index]:-}"
  fi
  if [[ -n "$dest" ]] && ! restore_planned_mounts "$name" "$dest" "$temp_path"; then
    message="Verified '${name}' but could not remount a nested mount on '${dest}'. The temporary source was kept and the new dataset was left in place."
    note_folder_error "$message"
    mark_folder_terminal "$folder_index" "failed" "$message"
    clear_recovery_state
    NESTED_UNMOUNTED_FOLDER=""
    return 1
  fi
  NESTED_UNMOUNTED_FOLDER=""
  log "Verification is clean for '$name'. Removing only the temporary source at '$temp_path'."
  if ! rm -rf --one-file-system -- "$temp_path"; then
    message="Failed to remove temporary source directory '$temp_path' after successful verification. The preserved source was not deleted."
    note_folder_error "$message"
    mark_folder_terminal "$folder_index" "failed" "$message"
    clear_recovery_state
    return 1
  fi
  clear_nested_plan "$name"
  clear_recovery_state
  if [[ "$folder_index" =~ ^[0-9]+$ && -n "${FOLDER_NAMES[$folder_index]:-}" ]]; then
    if [[ "${FOLDER_STATES[$folder_index]}" != "complete" ]]; then
      COMPLETED_FOLDERS=$((COMPLETED_FOLDERS + 1))
    fi
    folder_set "$folder_index" "complete" 100 "Migration complete."
  fi
  clear_handled_error
  return 0
}

stop_writers_for_paths() {
  local paths="$1"
  local saved_indexes="${2:-}"
  local running_ids=() id inspect name policy max_retry network_mode volumes_from depends_label
  local source path folder_indexes matched stop_indexes="" container_index folder_index folder_path
  if ! docker_daemon_is_running; then
    log "Docker is not running. No writer containers need to be stopped."
    if [[ -n "$saved_indexes" ]]; then
      stop_container_batch "$saved_indexes" || return 1
      ensure_batch_containers_stopped "$saved_indexes" || return 1
    fi
    return 0
  fi

  mapfile -t running_ids < <(docker ps -q 2>/dev/null || true)
  for id in "${running_ids[@]}"; do
    [[ -n "$id" ]] || continue
    inspect="$(container_inspect_line "$id")"
    [[ -n "$inspect" ]] || continue
    IFS='|' read -r id name policy max_retry network_mode volumes_from depends_label <<< "$inspect"
    name="${name#/}"
    folder_indexes="$(container_folder_indexes_from_mounts "$id")"
    matched=0
    while IFS= read -r source; do
      [[ -n "$source" ]] || continue
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if paths_touch "$source" "$path"; then
          matched=1
          log "Container ${name} mount '$source' overlaps migration path '$path'."
        fi
      done <<< "$paths"
    done < <(container_mount_sources "$id")
    if (( matched == 0 )) && [[ -z "$folder_indexes" ]]; then
      continue
    fi
    remember_running_container "$id" "$name" "$policy" "$max_retry" "$network_mode" "$volumes_from" "$depends_label" "$folder_indexes" "a mount overlaps a folder being migrated" || true
    if [[ -n "${CONTAINER_INDEX_BY_ID[$id]+x}" ]]; then
      stop_indexes="$(list_append_unique "$stop_indexes" "${CONTAINER_INDEX_BY_ID[$id]}")"
    elif [[ -n "${CONTAINER_INDEX_BY_NAME[$name]+x}" ]]; then
      stop_indexes="$(list_append_unique "$stop_indexes" "${CONTAINER_INDEX_BY_NAME[$name]}")"
    fi
  done
  close_running_container_dependencies
  for container_index in "${!CONTAINER_IDS[@]}"; do
    for folder_index in ${CONTAINER_FOLDER_INDEXES[$container_index]}; do
      folder_path="${FOLDER_SOURCE_PATHS[$folder_index]:-}"
      [[ -n "$folder_path" ]] || continue
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if [[ "$folder_path" == "$path" ]] || paths_touch "$folder_path" "$path"; then
          stop_indexes="$(list_append_unique "$stop_indexes" "$container_index")"
          break
        fi
      done <<< "$paths"
    done
  done
  stop_indexes="$(merge_index_lists "$stop_indexes" "$saved_indexes")"
  if [[ -z "$stop_indexes" ]]; then
    log "No running containers have a mount that overlaps the folder being migrated."
    return 0
  fi
  log "Stopping containers whose mounts overlap the folder being migrated, including containers tied to them by network container:, volumes_from, or compose depends_on."
  stop_container_batch "$stop_indexes" || return 1
  ensure_batch_containers_stopped "$stop_indexes" || return 1
}

repair_copy_into_dataset() {
  local src="$1"
  local dst="$2"
  [[ -d "$src" ]] || { log "Repair source is missing: $src"; return 1; }
  [[ -d "$dst" ]] || { log "Repair dataset path is missing: $dst"; return 1; }
  if [[ "$dst" == "$src" || "$src" == "$dst"/* ]]; then
    log "Refusing repair copy that would write into the preserved source: '$src' -> '$dst'."
    return 1
  fi
  log "Repair rsync --delete from preserved source '$src' into dataset '$dst'. The source is not modified."
  rsync_recover_exact "$src" "$dst"
}

run_rc() {
  local script="$1"
  local action="$2"
  local label="$3"
  if [[ ! -x "$script" ]]; then
    log "${label} script is not executable at ${script}. Skipping ${action}."
    return 1
  fi
  log "${label}: running ${script} ${action}"
  if "$script" "$action"; then
    log "${label}: ${script} ${action} finished."
    return 0
  fi
  log "WARNING: ${script} ${action} returned non-zero."
  return 1
}

wait_until_service_stops() {
  local check_name="$1"
  local label="$2"
  local spins=0 limit
  limit="$(service_stop_wait_seconds)"
  while "$check_name" && (( spins < limit )); do
    sleep 1
    spins=$((spins + 1))
  done
  if "$check_name"; then
    log "WARNING: ${label} is still running after ${limit}s."
    return 1
  fi
  log "${label} has stopped."
  return 0
}

libvirt_service_running() {
  if [[ -x "$RC_LIBVIRT" ]] && "$RC_LIBVIRT" status >/dev/null 2>&1; then
    return 0
  fi
  if command -v pgrep >/dev/null 2>&1 && pgrep -x libvirtd >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

lxc_stop_timeout() {
  local timeout="${ZFSAS_MIGRATOR_LXC_STOP_TIMEOUT:-}"
  if [[ -z "$timeout" && -r "$LXC_PLUGIN_CFG" ]]; then
    timeout="$(awk -F= '/^TIMEOUT=/ { gsub(/["[:space:]]/, "", $2); print $2; exit }' "$LXC_PLUGIN_CFG")"
  fi
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=15
  printf '%s' "$timeout"
}

lxc_active_names() {
  local line name
  command -v lxc-ls >/dev/null 2>&1 || return 0
  if lxc-ls -1 --active >/dev/null 2>&1; then
    lxc-ls -1 --active 2>/dev/null || true
    return 0
  fi
  line="$(lxc-ls --active 2>/dev/null || true)"
  [[ -n "$line" ]] || return 0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '%s\n' "$name"
  done < <(printf '%s\n' "$line" | tr ' ' '\n' | sed '/^$/d')
}

stop_lxc_containers_nicely() {
  local timeout container stopped=0
  command -v lxc-stop >/dev/null 2>&1 || {
    log "lxc-stop is not installed. Skipping LXC stop."
    return 0
  }
  timeout="$(lxc_stop_timeout)"
  while IFS= read -r container; do
    [[ -n "$container" ]] || continue
    stopped=1
    log "LXC nice stop for '$container' with lxc-stop --timeout=${timeout}, matching the LXC plugin unmounting_disks event."
    lxc-stop --timeout="$timeout" -n "$container" || log "WARNING: lxc-stop --timeout returned non-zero for '$container'."
  done < <(lxc_active_names)
  if (( stopped == 0 )); then
    log "No active LXC containers to stop."
  fi
  return 0
}

lxc_config_root() {
  local path="/var/lib/lxc" configured=""
  if [[ -r "$LXC_CONF" ]]; then
    configured="$(awk -F= '/^[[:space:]]*lxc\.lxcpath[[:space:]]*=/ { gsub(/["[:space:]]/, "", $2); print $2; exit }' "$LXC_CONF")"
  fi
  if [[ -n "$configured" ]]; then
    path="$configured"
  fi
  printf '%s' "$path"
}

lxc_container_running() {
  local name="$1"
  local state
  command -v lxc-info >/dev/null 2>&1 || return 1
  state="$(lxc-info -s -n "$name" 2>/dev/null | awk -F: 'tolower($1) ~ /state/ { gsub(/[[:space:]]/, "", $2); print toupper($2); exit }')"
  [[ "$state" == "RUNNING" ]]
}

start_lxc_autostart() {
  if [[ -x "$LXC_STARTUP_SCRIPT" ]]; then
    log "Starting LXC autostart containers with the LXC plugin startup script: $LXC_STARTUP_SCRIPT"
    "$LXC_STARTUP_SCRIPT" || log "WARNING: LXC startup script returned non-zero."
    return 0
  fi
  if command -v lxc-autostart >/dev/null 2>&1; then
    log "Starting LXC containers with lxc.start.auto=1 via lxc-autostart."
    lxc-autostart || log "WARNING: lxc-autostart returned non-zero."
    return 0
  fi
  log "lxc-autostart is not installed. Skipping LXC autostart."
  return 0
}

docker_container_running_by_name() {
  local name="$1"
  [[ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null || printf 'false')" == "true" ]]
}

log_non_autostart_workloads() {
  local name auto=""
  log "After services start, only autostart items are brought back. Docker uses ${DOCKER_AUTOSTART_FILE}. LXC uses lxc.start.auto=1. VMs use libvirt autostart. Nothing else is started by this step."
  if docker_daemon_is_running; then
    if [[ -r "$DOCKER_AUTOSTART_FILE" ]]; then
      auto="$(sed 's/^"//; s/"$//' "$DOCKER_AUTOSTART_FILE" || true)"
    fi
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      if ! printf '%s\n' "$auto" | grep -Fxq -- "$name"; then
        log "Docker container '$name' is running and is not in the Unraid autostart list. The service restart will not start it."
      fi
    done < <(docker ps --format '{{.Names}}' 2>/dev/null || true)
  fi
  if [[ -d "$LIBVIRT_AUTOSTART_DIR" ]] && command -v virsh >/dev/null 2>&1; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      if [[ ! -e "$LIBVIRT_AUTOSTART_DIR/$name.xml" && ! -L "$LIBVIRT_AUTOSTART_DIR/$name.xml" ]]; then
        log "VM '$name' is running and does not have libvirt autostart. The service restart will not start it."
      fi
    done < <(virsh list --name 2>/dev/null || true)
  fi
}

attention_for_docker_autostart() {
  local name
  if ! docker_daemon_is_running; then
    log "Docker is not running, so there is no autostart container follow-up."
    return 0
  fi
  if [[ ! -r "$DOCKER_AUTOSTART_FILE" ]]; then
    log "Docker autostart file is not present at $DOCKER_AUTOSTART_FILE."
    return 0
  fi
  while IFS= read -r name || [[ -n "$name" ]]; do
    name="$(trim "$name")"
    name="${name#\"}"
    name="${name%\"}"
    [[ -n "$name" && "$name" != \#* ]] || continue
    if docker_container_running_by_name "$name"; then
      log "Docker autostart container '$name' is running."
      continue
    fi
    log "Docker autostart container '$name' did not come up. Starting it once."
    if docker start "$name" >/dev/null 2>&1 && docker_container_running_by_name "$name"; then
      log "Docker autostart container '$name' started on the follow-up attempt."
    else
      log "Docker autostart container '$name' is still not running after one follow-up start."
    fi
  done < "$DOCKER_AUTOSTART_FILE"
}

attention_for_libvirt_autostart() {
  local link name state
  if [[ ! -d "$LIBVIRT_AUTOSTART_DIR" ]]; then
    log "Libvirt autostart directory is not present at $LIBVIRT_AUTOSTART_DIR."
    return 0
  fi
  if ! command -v virsh >/dev/null 2>&1; then
    log "virsh is not available. Skipping VM autostart follow-up."
    return 0
  fi
  for link in "$LIBVIRT_AUTOSTART_DIR"/*; do
    [[ -e "$link" || -L "$link" ]] || continue
    name="$(basename -- "$link")"
    name="${name%.xml}"
    [[ -n "$name" ]] || continue
    state="$(trim "$(virsh domstate "$name" 2>/dev/null || true)")"
    if [[ "$state" == "running" ]]; then
      log "Autostart VM '$name' is running."
      continue
    fi
    log "Autostart VM '$name' is not running (state '${state:-unknown}'). Starting it once."
    if virsh start "$name" >/dev/null 2>&1; then
      state="$(trim "$(virsh domstate "$name" 2>/dev/null || true)")"
      if [[ "$state" == "running" ]]; then
        log "Autostart VM '$name' started on the follow-up attempt."
      else
        log "Autostart VM '$name' is still not running after one follow-up start (state '${state:-unknown}')."
      fi
    else
      log "Autostart VM '$name' failed the follow-up start."
    fi
  done
}

attention_for_lxc_autostart() {
  local root config name nullglob_was=0
  local -a configs=()
  root="$(lxc_config_root)"
  if [[ ! -d "$root" ]]; then
    log "LXC path '$root' is not present. Skipping LXC autostart follow-up."
    return 0
  fi
  command -v lxc-stop >/dev/null 2>&1 || return 0
  command -v lxc-start >/dev/null 2>&1 || return 0
  shopt -q nullglob && nullglob_was=1
  shopt -s nullglob
  configs=("$root"/*/config)
  if (( nullglob_was == 0 )); then
    shopt -u nullglob
  fi
  for config in "${configs[@]}"; do
    [[ -f "$config" ]] || continue
    if ! grep -Eq '^[[:space:]]*lxc\.start\.auto[[:space:]]*=[[:space:]]*1([[:space:]]|$)' "$config"; then
      continue
    fi
    name="$(basename -- "$(dirname -- "$config")")"
    if lxc_container_running "$name"; then
      log "Autostart LXC '$name' is running."
      continue
    fi
    log "Autostart LXC '$name' did not start properly. Force-stopping it with lxc-stop --kill, then starting it once."
    lxc-stop --kill -n "$name" >/dev/null 2>&1 || log "WARNING: lxc-stop --kill returned non-zero for '$name'."
    if lxc-start -n "$name" >/dev/null 2>&1 && lxc_container_running "$name"; then
      log "Autostart LXC '$name' started on the follow-up attempt."
    else
      log "Autostart LXC '$name' is still not running after the follow-up start."
    fi
  done
}

last_resort_revert_folder() {
  local folder_index="$1"
  local original_path="$2"
  local temp_path="$3"
  local target_dataset="$4"
  local stopped_docker=0 stopped_libvirt=0 stopped_lxc=0
  local destroy_ok=0 restored=0 settle name
  name="${RECOVERY_ORIGINAL_NAME:-folder}"
  if [[ "$folder_index" =~ ^[0-9]+$ && -n "${FOLDER_NAMES[$folder_index]:-}" ]]; then
    name="${FOLDER_NAMES[$folder_index]}"
  fi

  if [[ ! -d "$temp_path" ]]; then
    log "Preserved source for '$name' is missing at '$temp_path'. Refusing to destroy dataset '$target_dataset'."
    mark_folder_terminal "$folder_index" "failed" "Verification could not be repaired and the preserved source is missing, so the dataset was left in place."
    clear_recovery_state
    return 0
  fi

  set_status "last_resort" "stopping_services" "Repair attempts failed for $name. Stopping Docker, VMs, and LXC so the broken dataset can be removed."
  log "Repair attempts are exhausted for '$name'. Last resort: stop Docker, libvirt, and LXC, destroy dataset '$target_dataset', and restore '$temp_path' to '$original_path'."
  log_non_autostart_workloads

  if docker_daemon_is_running; then
    if run_rc "$RC_DOCKER" stop "Docker"; then
      stopped_docker=1
    fi
    wait_until_service_stops docker_daemon_is_running "Docker" || true
  else
    log "Docker is already stopped."
  fi

  if libvirt_service_running; then
    if run_rc "$RC_LIBVIRT" stop "VMs"; then
      stopped_libvirt=1
    fi
    wait_until_service_stops libvirt_service_running "libvirt" || true
  else
    log "libvirt is already stopped."
  fi

  if [[ -n "$(lxc_active_names || true)" ]]; then
    stop_lxc_containers_nicely || true
    stopped_lxc=1
  fi

  if dataset_exists "$target_dataset"; then
    log "Destroying broken dataset with zfs destroy -r: $target_dataset"
    if zfs destroy -r "$target_dataset"; then
      destroy_ok=1
      log "Destroyed dataset $target_dataset."
    else
      log "WARNING: zfs destroy -r failed for $target_dataset. The preserved source stays at '$temp_path' and was not deleted."
    fi
  else
    destroy_ok=1
    log "Dataset $target_dataset is already gone."
  fi

  if (( destroy_ok == 1 )) && [[ -d "$temp_path" && ! -e "$original_path" ]]; then
    log "Restoring the original folder name: '$temp_path' -> '$original_path'"
    if mv -- "$temp_path" "$original_path"; then
      restored=1
      log "Restored original folder '$original_path'."
    else
      log "WARNING: Could not move '$temp_path' back to '$original_path'. The preserved source was not deleted."
    fi
  elif (( destroy_ok == 1 )) && [[ -e "$original_path" ]]; then
    log "WARNING: '$original_path' still exists after destroy, so '$temp_path' was left in place."
  fi

  if (( restored == 1 )) && [[ -d "$original_path" ]]; then
    restore_planned_mounts "$name" "$original_path" "$original_path" || log "Could not remount nested mounts for '$name' after restoring the folder."
  elif [[ -d "$temp_path" ]]; then
    restore_planned_mounts "$name" "$temp_path" "$temp_path" || log "Could not remount nested mounts for '$name' on the preserved source."
  fi
  NESTED_UNMOUNTED_FOLDER=""

  set_status "last_resort" "starting_services" "Starting libvirt, Docker, and LXC autostart after restoring $name."
  if (( stopped_libvirt == 1 )); then
    run_rc "$RC_LIBVIRT" start "VMs" || true
    log "libvirt was started. VMs with libvirt autostart come back on their own."
  fi
  if (( stopped_docker == 1 )); then
    run_rc "$RC_DOCKER" start "Docker" || true
    log "Docker was started. Containers listed in $DOCKER_AUTOSTART_FILE come back on their own."
  fi
  if (( stopped_lxc == 1 )); then
    start_lxc_autostart || true
  fi

  settle="$(service_settle_seconds)"
  set_status "settling" "autostart_settle" "Waiting ${settle}s for autostarted Docker containers, VMs, and LXC containers to settle."
  log "Waiting ${settle}s for autostarted services to settle before checking anything that did not come up."
  sleep "$settle"

  set_status "settling" "autostart_attention" "Checking autostarted Docker containers, VMs, and LXC containers."
  log "Checking autostart items that did not come up."
  attention_for_lxc_autostart || true
  attention_for_docker_autostart || true
  attention_for_libvirt_autostart || true

  clear_recovery_state
  if (( restored == 1 )); then
    mark_folder_terminal "$folder_index" "reverted" "Verification could not be repaired. Docker, VMs, and LXC were stopped, the new dataset was removed, and the original folder name was restored."
    log "Folder '$name' was reverted. The migration queue will continue with the remaining folders."
  else
    mark_folder_terminal "$folder_index" "failed" "Verification could not be repaired and the original folder could not be restored. The preserved source was not deleted. See the migrator log."
    log "Folder '$name' was marked failed. The preserved source was not deleted. The migration queue will continue with the remaining folders."
  fi
  return 0
}

repair_folder_in_place() {
  local folder_index="$1"
  local original_path="$2"
  local temp_path="$3"
  local target_dataset="$4"
  local saved_indexes="${5:-${RECOVERY_BATCH_CONTAINERS:-}}"
  local limit attempt paths name source_bytes progress="80"
  limit="$(repair_attempt_limit)"
  name="${RECOVERY_ORIGINAL_NAME:-folder}"
  if [[ "$folder_index" =~ ^[0-9]+$ && -n "${FOLDER_NAMES[$folder_index]:-}" ]]; then
    name="${FOLDER_NAMES[$folder_index]}"
  fi
  paths="$(printf '%s\n%s\n' "$original_path" "$temp_path")"

  log "Starting in-place repair for '$name' using existing dataset '$target_dataset'. Preserved source: $temp_path. The source is not modified, and the dataset is not destroyed during repair."
  for (( attempt = 1; attempt <= limit; attempt++ )); do
    set_status "repairing" "repair_pause" "Pausing before repair attempt ${attempt} of ${limit} for $name."
    log "Repair attempt ${attempt} of ${limit} for '$name'. Pausing ${RECOVERY_BOOT_DELAY_SECONDS}s, then copying the preserved source into the existing dataset."
    sleep "$RECOVERY_BOOT_DELAY_SECONDS"
    if [[ "$folder_index" =~ ^[0-9]+$ ]]; then
      progress="${FOLDER_PROGRESS[$folder_index]:-80}"
    fi
    folder_set "$folder_index" "repairing" "$progress" "Repair attempt ${attempt} of ${limit}."
    if ! stop_writers_for_paths "$paths" "$saved_indexes"; then
      log "Repair attempt ${attempt} could not confirm writer containers were stopped."
      continue
    fi
    if [[ -d "$temp_path" ]]; then
      source_bytes="$(get_directory_used_bytes "$temp_path" 2>/dev/null || true)"
      if [[ "$source_bytes" =~ ^[0-9]+$ ]]; then
        wait_for_resume_space "$name" "$folder_index" || return 1
      fi
    fi
    if ! repair_copy_into_dataset "$temp_path" "$original_path"; then
      log "Repair attempt ${attempt} copy failed for '$name'. The preserved source was not modified."
      clear_handled_error
      continue
    fi
    ensure_planned_mountpoint_dirs "$name" "$original_path" "$temp_path"
    if verify_copied_folder "$temp_path" "$original_path" "$folder_index"; then
      log "Repair attempt ${attempt} verified clean for '$name'."
      cut_over_verified_folder "$folder_index" "$temp_path"
      return $?
    fi
    log "Repair attempt ${attempt} of ${limit} still does not match for '$name'. The temporary source was kept."
    clear_handled_error
  done

  log "All ${limit} repair attempts failed for '$name'."
  last_resort_revert_folder "$folder_index" "$original_path" "$temp_path" "$target_dataset"
}

migrate_one_directory() {
  local folder_index="$1"
  local protected_container_indexes="${2:-}"
  local entry_path="${FOLDER_SOURCE_PATHS[$folder_index]}"
  local name="${FOLDER_NAMES[$folder_index]}"
  local child_ds="${FOLDER_TARGET_DATASETS[$folder_index]}"
  local parent_path temp_name temp_path new_path mounted_dataset source_bytes required_bytes

  CURRENT_FOLDER_INDEX="$folder_index"
  CURRENT_FOLDER="$name"
  CURRENT_FOLDER_PERCENT=0
  parent_path="$(dirname "$entry_path")"
  new_path="$entry_path"
  temp_path=""

  folder_set "$folder_index" "preparing" 2 "Preparing folder for migration."
  ensure_batch_containers_stopped "$protected_container_indexes" || return 1

  prepare_sockets_for_migration "$entry_path" || {
    abort_folder_migration "$folder_index" "$entry_path" "" "" "failed" "Active socket files are still present under '$entry_path'. Make sure every container and watchdog is stopped before migrating."
    return 1
  }
  if ! prepare_nested_mounts_before_cutover "$folder_index"; then
    return 1
  fi

  source_bytes="$(get_directory_used_bytes "$entry_path")"
  [[ "$source_bytes" =~ ^[0-9]+$ ]] || {
    abort_folder_migration "$folder_index" "$entry_path" "" "" "failed" "Could not determine source size for '$entry_path'"
    return 1
  }
  required_bytes="$(calculate_required_free_bytes "$source_bytes")"
  if ! wait_for_free_space "$required_bytes" "$name" "$folder_index"; then
    abort_folder_migration "$folder_index" "$entry_path" "" "" "failed" "${LAST_ERROR:-Could not confirm free space for '$name'. The folder was left unchanged.}"
    return 1
  fi
  set_status "migrating" "renaming_source" "Preparing $name for child dataset creation."

  temp_name="$(migration_temp_name "$name")"
  temp_path="${parent_path}/${temp_name}"
  if [[ -e "$temp_path" ]]; then
    abort_folder_migration "$folder_index" "$entry_path" "" "" "failed" "Temporary path already exists: $temp_path"
    return 1
  fi

  if ! mv -- "$entry_path" "$temp_path"; then
    abort_folder_migration "$folder_index" "$entry_path" "" "" "failed" "Failed to rename '$entry_path' to temporary path '$temp_path'"
    return 1
  fi
  RECOVERY_PHASE="renamed_source"
  RECOVERY_FOLDER_INDEX="$folder_index"
  RECOVERY_SOURCE_PATH="$entry_path"
  RECOVERY_TEMP_PATH="$temp_path"
  RECOVERY_TARGET_DATASET="$child_ds"
  RECOVERY_BATCH_CONTAINERS="$protected_container_indexes"
  RECOVERY_ORIGINAL_NAME="$name"
  write_recovery_state

  if ! wait_for_free_space "$required_bytes" "$name" "$folder_index"; then
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "${LAST_ERROR:-Could not confirm free space for '$name' after preparing the folder.}"
    return 1
  fi

  if folder_has_live_nested_mount "$temp_path" || folder_has_live_nested_mount "$entry_path"; then
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "" "skipped" "Skipped '${name}' because a nested mount is still active. No parent dataset was created."
    return 1
  fi

  log "Creating dataset: $child_ds"
  if ! zfs create "$child_ds"; then
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "Dataset creation failed: $child_ds"
    return 1
  fi
  RECOVERY_PHASE="dataset_created"
  write_recovery_state

  if ! assert_path_is_mountpoint_for_dataset "$child_ds" "$new_path"; then
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "${LAST_ERROR:-Dataset '$child_ds' was not mounted at '$new_path'.}"
    return 1
  fi
  if ! verify_destination_is_empty "$new_path"; then
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "${LAST_ERROR:-Destination path is not empty: $new_path}"
    return 1
  fi

  chown --reference="$temp_path" "$new_path"
  chmod --reference="$temp_path" "$new_path"
  touch --reference="$temp_path" "$new_path"

  folder_set "$folder_index" "copying" 5 "Copying data into the new dataset."
  if ! rsync_copy_with_progress "$temp_path" "$new_path" "$folder_index"; then
    if dataset_is_mounted_at "$child_ds" "$new_path" && [[ -d "$temp_path" ]]; then
      log "Copy did not finish for '$name'. The new dataset was not destroyed. Starting in-place repair from the preserved source."
      repair_folder_in_place "$folder_index" "$entry_path" "$temp_path" "$child_ds" "$protected_container_indexes"
      return $?
    fi
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "${LAST_ERROR:-Copy failed for '$name'. The folder was left unchanged where possible.}"
    return 1
  fi
  if ! ensure_batch_containers_stopped "$protected_container_indexes"; then
    if dataset_is_mounted_at "$child_ds" "$new_path" && [[ -d "$temp_path" ]]; then
      log "A writer container was running after the copy for '$name'. Starting in-place repair without destroying the dataset."
      repair_folder_in_place "$folder_index" "$entry_path" "$temp_path" "$child_ds" "$protected_container_indexes"
      return $?
    fi
    abort_folder_migration "$folder_index" "$entry_path" "$temp_path" "$child_ds" "failed" "${LAST_ERROR:-A writer container was running after the copy for '$name'.}"
    return 1
  fi
  sync

  ensure_planned_mountpoint_dirs "$name" "$new_path" "$temp_path"
  if ! verify_copied_folder "$temp_path" "$new_path" "$folder_index"; then
    repair_folder_in_place "$folder_index" "$entry_path" "$temp_path" "$child_ds" "$protected_container_indexes"
    return $?
  fi

  cut_over_verified_folder "$folder_index" "$temp_path"
  return $?
}

migration_has_handled_failures() {
  local index
  for index in "${!FOLDER_STATES[@]}"; do
    case "${FOLDER_STATES[$index]}" in
      failed|reverted|skipped) return 0 ;;
    esac
  done
  return 1
}

finish_migration() {
  local message="${1:-Dataset migration finished.}"
  if (( NEEDS_CONTAINER_RECOVERY == 1 )); then
    set_status "restarting_containers" "restarting_containers" "Starting containers back up."
    start_selected_containers || true
  fi
  CURRENT_FOLDER=""
  CURRENT_FOLDER_PERCENT=100
  ENDED_EPOCH="$(date +%s)"
  if migration_has_handled_failures; then
    STATE="complete_with_failures"
    CURRENT_STEP="complete_with_failures"
    MESSAGE="Dataset migration finished. Some folders were skipped, reverted, or failed and were left as directories. The log lists each one. The other folders were migrated."
  else
    STATE="complete"
    CURRENT_STEP="complete"
    MESSAGE="$message"
  fi
  MIGRATION_COMPLETE=1
  clear_in_progress_flag
  rm -f -- "$REVERTED_FOLDERS_FILE" >/dev/null 2>&1 || true
  write_status_file
  log "$MESSAGE"
}

build_folder_plan() {
  local parent_path child name target_ds mounted_dataset size_bytes folder_index handled handled_state handled_message
  FOLDER_NAMES=()
  FOLDER_SOURCE_PATHS=()
  FOLDER_TARGET_DATASETS=()
  FOLDER_SIZE_BYTES=()
  FOLDER_STATES=()
  FOLDER_PROGRESS=()
  FOLDER_MESSAGES=()
  FOLDER_CONTAINER_INDEXES=()
  FOLDER_INDEX_BY_NAME=()
  COMPLETED_FOLDERS=0
  ACTIVE_MOUNTPOINT="$(zfs get -H -o value mountpoint "$ACTIVE_DATASET" 2>/dev/null | head -n 1 || true)"
  [[ -n "$ACTIVE_MOUNTPOINT" && "$ACTIVE_MOUNTPOINT" != "legacy" && "$ACTIVE_MOUNTPOINT" != "none" ]] || die "Dataset $ACTIVE_DATASET does not have a readable mounted filesystem path."
  [[ -d "$ACTIVE_MOUNTPOINT" ]] || die "Mountpoint $ACTIVE_MOUNTPOINT does not exist or is not a directory."
  ACTIVE_MOUNTPOINT_REAL="$(canonicalize_host_path "$ACTIVE_MOUNTPOINT")"
  [[ -n "$ACTIVE_MOUNTPOINT_REAL" && -d "$ACTIVE_MOUNTPOINT_REAL" ]] || die "Could not resolve a usable canonical mountpoint path for $ACTIVE_DATASET."

  while IFS= read -r -d '' child; do
    name="$(basename "$child")"
    [[ "$name" == *"$MIGRATION_TEMP_MARKER"* ]] && continue
    [[ "$name" == "." || "$name" == ".." ]] && continue
    [[ "$name" =~ ^[A-Za-z0-9._:+\-]+$ ]] || continue

    target_ds="${ACTIVE_DATASET}/${name}"
    handled="$(handled_folder_record "$name" || true)"
    if [[ -n "$handled" ]]; then
      handled_state="${handled%%$'\t'*}"
      handled_message="${handled#*$'\t'}"
      folder_index="${#FOLDER_NAMES[@]}"
      FOLDER_NAMES+=("$name")
      FOLDER_SOURCE_PATHS+=("$child")
      FOLDER_TARGET_DATASETS+=("$target_ds")
      FOLDER_SIZE_BYTES+=("0")
      FOLDER_STATES+=("${handled_state:-reverted}")
      FOLDER_PROGRESS+=("0")
      FOLDER_MESSAGES+=("${handled_message:-Left as the original folder after verification could not be repaired.}")
      FOLDER_CONTAINER_INDEXES+=("")
      FOLDER_INDEX_BY_NAME["$name"]="$folder_index"
      case "${handled_state:-reverted}" in
        complete|failed|reverted|skipped) COMPLETED_FOLDERS=$((COMPLETED_FOLDERS + 1)) ;;
      esac
      continue
    fi
    dataset_exists "$target_ds" && continue

    mounted_dataset="$(dataset_mounted_at_path "$child")"
    if [[ -n "$mounted_dataset" ]]; then
      continue
    fi

    classify_folder_nested_mounts "$child" "$name"
    if [[ "$NESTED_DECISION" == "skip" ]]; then
      log "Skipping '${name}' at plan time: ${NESTED_DECISION_MESSAGE}"
      record_handled_folder "$name" "skipped" "$NESTED_DECISION_MESSAGE"
      folder_index="${#FOLDER_NAMES[@]}"
      FOLDER_NAMES+=("$name")
      FOLDER_SOURCE_PATHS+=("$child")
      FOLDER_TARGET_DATASETS+=("$target_ds")
      FOLDER_SIZE_BYTES+=("0")
      FOLDER_STATES+=("skipped")
      FOLDER_PROGRESS+=("0")
      FOLDER_MESSAGES+=("$NESTED_DECISION_MESSAGE")
      FOLDER_CONTAINER_INDEXES+=("")
      FOLDER_INDEX_BY_NAME["$name"]="$folder_index"
      COMPLETED_FOLDERS=$((COMPLETED_FOLDERS + 1))
      continue
    fi

    size_bytes="$(get_directory_used_bytes "$child" 2>/dev/null || true)"
    [[ "$size_bytes" =~ ^[0-9]+$ ]] || size_bytes=0

    folder_index="${#FOLDER_NAMES[@]}"
    FOLDER_NAMES+=("$name")
    FOLDER_SOURCE_PATHS+=("$child")
    FOLDER_TARGET_DATASETS+=("$target_ds")
    FOLDER_SIZE_BYTES+=("$size_bytes")
    FOLDER_STATES+=("queued")
    FOLDER_PROGRESS+=("0")
    FOLDER_MESSAGES+=("Queued for migration.")
    FOLDER_CONTAINER_INDEXES+=("")
    FOLDER_INDEX_BY_NAME["$name"]="$folder_index"
  done < <(find "$ACTIVE_MOUNTPOINT" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

  TOTAL_FOLDERS="${#FOLDER_NAMES[@]}"
  write_status_file
  if (( TOTAL_FOLDERS == 0 )); then
    if (( RESUMING_AFTER_RECOVERY == 1 )) || { (( IN_PROGRESS_FLAG_PREEXISTED == 1 )) && [[ ! -e "$RECOVERY_STATE_FILE" ]]; }; then
      finish_migration "Dataset migration already finished. No eligible folders remain under $ACTIVE_DATASET."
      return 0
    fi
    clear_in_progress_flag
    die "No eligible top-level folders were found under $ACTIVE_DATASET."
    return 1
  fi
}

rsync_recover_exact() {
  local src="$1"
  local dst="$2"
  [[ -d "$src" ]] || die "Recovery source temp folder is missing: $src"
  [[ -d "$dst" ]] || die "Recovery destination dataset path is missing: $dst"
  rsync -aHAXx --delete --numeric-ids "$src"/ "$dst"/ || die "Recovery exact rsync failed from '$src' to '$dst'"
  sync
}

run_delayed_recovery() {
  if ! load_recovery_state; then
    if [[ -z "$ACTIVE_DATASET" ]]; then
      ACTIVE_DATASET="$(read_in_progress_dataset || true)"
    fi
    if ! discover_leftover_temp_recovery; then
      log "No pending Dataset Migrator recovery state found."
      return 0
    fi
  fi

  if [[ -z "$ACTIVE_DATASET" ]]; then
    ACTIVE_DATASET="$(read_in_progress_dataset || true)"
  fi
  if [[ ! -e "$IN_PROGRESS_FLAG" ]]; then
    write_in_progress_flag
  fi

  notify_interrupted_migration
  set_status "recovering" "boot_delay" "Dataset migration was interrupted. Apps may not function properly until migration completes. Recovery will resume in about 15 minutes; ignore non-functioning apps until then."

  [[ -n "$RECOVERY_TEMP_PATH" ]] || die "Recovery state is missing the preserved source temp path."
  [[ -n "$RECOVERY_TARGET_DATASET" ]] || die "Recovery state is missing the target dataset."
  if ! dataset_exists "$RECOVERY_TARGET_DATASET"; then
    log "Recovery target dataset is missing. Creating $RECOVERY_TARGET_DATASET."
    zfs create "$RECOVERY_TARGET_DATASET" || die "Recovery could not create target dataset: $RECOVERY_TARGET_DATASET"
  fi

  local recovery_destination
  recovery_destination="${RECOVERY_SOURCE_PATH:-}"
  if [[ -z "$recovery_destination" ]]; then
    recovery_destination="$(zfs get -H -o value mountpoint "$RECOVERY_TARGET_DATASET" 2>/dev/null | head -n 1 || true)"
  fi
  [[ -n "$recovery_destination" ]] || die "Recovery could not determine destination path for $RECOVERY_TARGET_DATASET"

  if ! repair_folder_in_place "${RECOVERY_FOLDER_INDEX:--1}" "$recovery_destination" "$RECOVERY_TEMP_PATH" "$RECOVERY_TARGET_DATASET" "${RECOVERY_BATCH_CONTAINERS:-}"; then
    local handled=""
    handled="$(handled_folder_record "${RECOVERY_ORIGINAL_NAME:-}" || true)"
    if [[ -n "$handled" ]]; then
      log "Recovery for '${RECOVERY_ORIGINAL_NAME}' is recorded as ${handled%%$'\t'*}. Continuing the remaining folders."
      RESUMING_AFTER_RECOVERY=1
      return 0
    fi
    return 1
  fi
  if (( MIGRATION_COMPLETE == 1 )); then
    return 0
  fi
  RESUMING_AFTER_RECOVERY=1
  log "Interrupted folder is handled. Resuming the remaining migration queue for ${ACTIVE_DATASET}."
  return 0
}

# shellcheck disable=SC2329
cleanup() {
  local exit_code="$?"
  if (( EXIT_CODE == 0 )) && (( exit_code != 0 )); then
    EXIT_CODE="$exit_code"
  fi

  if (( MIGRATION_COMPLETE == 0 )) && [[ "$EXIT_CODE" -ne 0 ]]; then
    LAST_ERROR="${LAST_ERROR:-Dataset migration stopped before completion.}"
    if [[ -e "$RECOVERY_STATE_FILE" ]]; then
      notify_interrupted_migration
    fi
    if (( NEEDS_CONTAINER_RECOVERY == 1 )); then
      log "Migration did not finish cleanly. Attempting to restart previously running containers before exiting."
      start_selected_containers || true
    fi
    STATE="failed"
    CURRENT_STEP="failed"
    MESSAGE="$LAST_ERROR"
    ENDED_EPOCH="$(date +%s)"
    write_status_file
    exit "$EXIT_CODE"
  fi

  if (( MIGRATION_COMPLETE == 1 )); then
    exit 0
  fi

  exit "$EXIT_CODE"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

while (( $# > 0 )); do
  case "$1" in
    --dataset)
      shift
      DATASET="$(trim "${1:-}")"
      ;;
    --recover-pending)
      RUN_RECOVERY=1
      ;;
    --kick-if-idle)
      KICK_IF_IDLE=1
      ;;
  esac
  shift || true
done

if (( KICK_IF_IDLE == 1 )); then
  if [[ ! -e "$RECOVERY_STATE_FILE" && ! -e "$IN_PROGRESS_FLAG" && ! -s "$(restart_policy_pending_file)" ]]; then
    exit 0
  fi
elif (( RUN_RECOVERY == 0 )); then
  [[ -n "$DATASET" ]] || die "Dataset is required."
  [[ "$DATASET" =~ ^[A-Za-z0-9._/:+\-]+$ ]] || die "Dataset name is invalid."
  ACTIVE_DATASET="$DATASET"
fi

ensure_dir "$PLUGIN_ROOT"
ensure_dir "$LOGS_DIR"
ensure_dir "$(dirname "$LOCK_FILE")"
zfsas_log_prepare_for_append "$LOG_FILE" "$LOG_ARCHIVE_FILE" 1048576 600 20 2097152 || true
exec > >(tee -a "$LOG_FILE") 2>&1

if (( KICK_IF_IDLE == 1 )); then
  kick_pending_migration || true
  exit 0
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "Another dataset migration appears to already be running."
  exit 0
fi
chmod 0640 "$LOCK_FILE" >/dev/null 2>&1 || true
apply_owner "$LOCK_FILE"

trap cleanup EXIT INT TERM

restore_restart_policies_left_disabled || true

if (( RUN_RECOVERY == 1 )); then
  run_delayed_recovery || exit 1
  if (( RESUMING_AFTER_RECOVERY != 1 )); then
    exit 0
  fi
else
  IN_PROGRESS_FLAG_PREEXISTED=0
  [[ -e "$IN_PROGRESS_FLAG" ]] && IN_PROGRESS_FLAG_PREEXISTED=1
  if (( IN_PROGRESS_FLAG_PREEXISTED == 0 )); then
    rm -f -- "$REVERTED_FOLDERS_FILE" >/dev/null 2>&1 || true
  fi
  write_in_progress_flag

  if [[ -e "$RECOVERY_STATE_FILE" ]] || discover_leftover_temp_recovery; then
    run_delayed_recovery || exit 1
    if (( MIGRATION_COMPLETE == 1 )); then
      exit 0
    fi
  fi
fi

if (( RESUMING_AFTER_RECOVERY == 1 )); then
  log "Resuming the remaining migration queue for ${ACTIVE_DATASET}."
  set_status "migrating" "resuming_queue" "The interrupted folder is handled. Continuing with the remaining folders."
fi

if parity_sync_in_progress; then
  die "A parity check or sync is currently running. Stop it before proceeding."
  write_status_file
  exit 1
fi

if mover_is_running; then
  die "The Unraid mover is currently running. Wait for it to finish or disable the mover schedule before proceeding."
  write_status_file
  exit 1
fi

if ! dataset_exists "$ACTIVE_DATASET"; then
  die "Dataset does not exist: $ACTIVE_DATASET"
  write_status_file
  exit 1
fi

set_status "preparing" "planning" "Scanning the selected dataset for eligible top-level folders."
build_folder_plan || exit 1
if (( MIGRATION_COMPLETE == 1 )); then
  exit 0
fi

record_running_containers
set_status "migrating" "migrating" "Starting folder-by-folder migration."

while CURRENT_FOLDER_INDEX="$(next_pending_folder_index)"; do
  select_batch_for_folder "$CURRENT_FOLDER_INDEX"
  if ! preflight_space_for_folder "$CURRENT_FOLDER_INDEX"; then
    handle_folder_problem "$CURRENT_FOLDER_INDEX" "failed" "${LAST_ERROR:-Could not confirm free space for this folder. It was left unchanged.}"
    continue
  fi
  if [[ -n "$CURRENT_BATCH_CONTAINERS" ]]; then
    if ! stop_container_batch "$CURRENT_BATCH_CONTAINERS"; then
      handle_folder_problem "$CURRENT_FOLDER_INDEX" "failed" "${LAST_ERROR:-Could not stop the containers for this folder. It was left unchanged.}"
      continue
    fi
  fi

  batch_failed=0
  for CURRENT_FOLDER_INDEX in $(build_folder_batch_order "$CURRENT_BATCH_FOLDERS" "$CURRENT_BATCH_CONTAINERS"); do
    if ! folder_is_pending "$CURRENT_FOLDER_INDEX"; then
      continue
    fi
    CURRENT_FOLDER="${FOLDER_NAMES[$CURRENT_FOLDER_INDEX]}"
    CURRENT_FOLDER_PERCENT="${FOLDER_PROGRESS[$CURRENT_FOLDER_INDEX]:-0}"
    if ! migrate_one_directory "$CURRENT_FOLDER_INDEX" "$CURRENT_BATCH_CONTAINERS"; then
      handle_folder_problem "$CURRENT_FOLDER_INDEX" "failed" "${LAST_ERROR:-This folder could not be migrated. It was left unchanged.}"
      batch_failed=1
      break
    fi
  done

  if (( batch_failed == 0 )) && [[ -n "${CURRENT_BATCH_CONTAINERS:-}" ]]; then
    set_status "restarting_containers" "restarting_containers" "Starting containers back up after the current migration batch."
    start_selected_containers "$CURRENT_BATCH_CONTAINERS" || true
  fi
done

if (( NEEDS_CONTAINER_RECOVERY == 1 )); then
  set_status "restarting_containers" "restarting_containers" "Starting any remaining containers back up."
  start_selected_containers || true
fi

if [[ -n "${CURRENT_BATCH_CONTAINERS:-}" ]]; then
  CURRENT_BATCH_CONTAINERS=""
fi
if [[ -n "${CURRENT_BATCH_FOLDERS:-}" ]]; then
  CURRENT_BATCH_FOLDERS=""
fi

while folder_index="$(next_pending_folder_index)"; do
  mark_folder_terminal "$folder_index" "failed" "This folder was still queued at the end of the migration. It was left unchanged so the queue does not retry it forever."
done

finish_migration "Dataset migration finished successfully for $ACTIVE_DATASET."
exit 0
